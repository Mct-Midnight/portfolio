---
// Page dynamique pour les études de cas de projets (Oral E4 · Bloc 1)
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Footer from '../../components/Footer.astro';
import {
  ArrowLeft,
  Calendar,
  Github,
  ExternalLink,
  ShieldCheck,
  CheckCircle,
  FileCode,
} from 'lucide-astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();

// Libellé et couleur du statut selon Midnight & Cobalt
function getStatusDetails(status: string) {
  switch (status) {
    case 'réalisé':
      return {
        label: 'Projet Réalisé & Validé',
        class: 'bg-emerald-50 text-emerald-800 border-emerald-200',
      };
    case 'en cours':
      return {
        label: 'Projet En Cours de Réalisation',
        class: 'bg-amber-50 text-amber-800 border-amber-200',
      };
    case 'à venir':
      return {
        label: 'Projet Planifié',
        class: 'bg-slate-100 text-slate-700 border-slate-200',
      };
    default:
      return {
        label: status,
        class: 'bg-slate-50 text-slate-700 border-slate-200',
      };
  }
}

const statusDetails = getStatusDetails(project.data.status);
---

<Layout
  title={`${project.data.title} — Étude de Cas BTS SIO SLAM`}
  description={`Fiche d'étude de cas officielle pour le projet « ${project.data.title} », adossé au Bloc 1 du BTS SIO SLAM.`}
>
  <div class="flex min-h-screen bg-slate-50">
    
    <!-- Sidebar fixe -->
    <Sidebar currentPath={`/projets/${project.slug}`} />

    <!-- Zone principale -->
    <div class="flex-1 w-full lg:pl-[260px] flex flex-col min-w-0">
      
      <main class="flex-1 max-w-4xl w-full mx-auto px-5 sm:px-8 lg:px-10 pt-20 lg:pt-10 pb-16">
        
        <!-- Bouton Retour au Portfolio -->
        <div class="mb-6">
          <a
            href="/#projets"
            class="inline-flex items-center gap-2 text-xs font-bold font-title text-slate-900 hover:text-zinc-950 transition-colors py-2 px-3 rounded-lg hover:bg-white border border-transparent hover:border-slate-200"
          >
            <ArrowLeft class="w-4 h-4 text-zinc-900" />
            <span>Retour à la liste des réalisations</span>
          </a>
        </div>

        <!-- En-tête de l'étude de cas (Hero de projet) -->
        <header class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-card mb-10 space-y-5">
          
          <!-- Ligne de métadonnées supérieures -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
            
            <div class="flex items-center gap-2 flex-wrap">
              <!-- Badge de Catégorie avec icônes pleines (Solid) -->
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-900 text-white font-title">
                {project.data.category === 'freelance' ? (
                  <>
                    <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" viewBox="0 0 512 512" fill="currentColor">
                      <path d="M156.6 384.9L125.7 354c-8.5-8.5-11.5-20.8-7.7-32.2c3-8.9 7-20.5 11.8-33.8L24 288c-8.6 0-16.6-4.6-20.9-12.1s-4.2-16.7 .2-24.1l52.5-88.5c13-21.9 36.5-35.3 61.9-35.3l82.3 0c2.4-4 4.8-7.7 7.2-11.3C289.1-4.1 411.1-8.1 483.9 5.3c11.6 2.1 20.6 11.2 22.8 22.8c13.4 72.9 9.3 194.8-111.4 276.7c-3.5 2.4-7.3 4.8-11.3 7.2l0 82.3c0 25.4-13.4 49-35.3 61.9l-88.5 52.5c-7.4 4.4-16.6 4.5-24.1 .2s-12.1-12.2-12.1-20.9l0-107.2c-14.1 4.9-26.4 8.9-35.7 11.9c-11.2 3.6-23.4 .5-31.8-7.8zM384 168a40 40 0 1 0 0-80 40 40 0 1 0 0 80z"/>
                    </svg>
                    <span>Freelance</span>
                  </>
                ) : project.data.category === 'scolaire' ? (
                  <>
                    <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18c2.023 0 3.9.724 5.25 1.933V4.533Z" />
                      <path d="M12.75 4.533A9.707 9.707 0 0 1 18 3c1.135 0 2.228.194 3.25.555a.75.75 0 0 1 .5.707v14.25a.75.75 0 0 1-1 .707A8.237 8.237 0 0 0 18 18c-2.023 0-3.9.724-5.25 1.933V4.533Z" />
                    </svg>
                    <span>Scolaire</span>
                  </>
                ) : (
                  <>
                    <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M7.5 5.25a3 3 0 0 1 3-3h3a3 3 0 0 1 3 3v.75h3.75A2.25 2.25 0 0 1 22.5 8.25v9a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 17.25v-9A2.25 2.25 0 0 1 3.75 6H7.5v-.75Zm1.5.75h6v-.75a1.5 1.5 0 0 0-1.5-1.5h-3a1.5 1.5 0 0 0-1.5 1.5v.75Z" clip-rule="evenodd" />
                    </svg>
                    <span>Professionnel</span>
                  </>
                )}
              </span>

              <!-- Badge de Statut -->
              <span class={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold border ${statusDetails.class}`}>
                <CheckCircle class="w-3.5 h-3.5" />
                <span>{statusDetails.label}</span>
              </span>
            </div>

            <!-- Période de réalisation -->
            <div class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500">
              <Calendar class="w-3.5 h-3.5 text-zinc-900" />
              <span>Du {project.data.dateStart} au {project.data.dateEnd}</span>
            </div>

          </div>

          <!-- Titre principal -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold font-title text-slate-900 tracking-tight leading-tight">
            {project.data.title}
          </h1>

          <!-- Technologies mobilisées (Pastilles Titane) -->
          <div class="space-y-2">
            <span class="text-xs uppercase tracking-wider text-slate-400 font-bold block font-title">
              Technologies & Outils Mobilisés :
            </span>
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <span class="px-3 py-1 rounded-lg bg-zinc-100 text-zinc-800 text-xs font-medium border border-zinc-200">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Boutons de liens externes (GitHub / Démo) -->
          {(project.data.repoUrl || project.data.demoUrl) && (
            <div class="pt-2 flex flex-wrap items-center gap-3">
              {project.data.repoUrl && (
                <a
                  href={project.data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-colors border border-slate-800 group"
                >
                  <Github class="w-4 h-4 text-zinc-400" />
                  <span>Dépôt GitHub du projet</span>
                  <ExternalLink class="w-3 h-3 opacity-60 group-hover:opacity-100" />
                </a>
              )}

              {project.data.demoUrl && (
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-900 hover:bg-black text-white text-xs font-semibold shadow-sm transition-colors"
                >
                  <ExternalLink class="w-4 h-4" />
                  <span>Démonstration en direct</span>
                </a>
              )}
            </div>
          )}

          <!-- Badge Référentiel Officiel E4 -->
          <div class="bg-zinc-50 p-3 rounded-xl border border-zinc-200 flex items-center gap-3 text-xs text-slate-700">
            <ShieldCheck class="w-5 h-5 text-zinc-900 shrink-0" />
            <span>
              <strong>Document certifié pour l'Épreuve E4 :</strong> Les compétences justifiées en fin d'étude de cas correspondent à la nomenclature officielle du Bloc 1 (BTS SIO SLAM).
            </span>
          </div>

        </header>

        <!-- Corps de l'étude de cas (Rendu Markdown) -->
        <article class="markdown-content bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-card">
          <Content />
        </article>

        <!-- Navigation de fin de page -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4 p-6 bg-white rounded-2xl border border-slate-200 shadow-card">
          <div>
            <h4 class="font-bold font-title text-slate-900 text-sm">Fin de l'étude de cas</h4>
            <p class="text-xs text-slate-500">Consultez les autres projets ou contactez le candidat.</p>
          </div>
          <div class="flex items-center gap-3">
            <a
              href="/#projets"
              class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold transition-colors"
            >
              Tous les projets
            </a>
            <a
              href="/#contact"
              class="px-4 py-2.5 rounded-xl bg-zinc-900 hover:bg-black text-white text-xs font-semibold transition-colors"
            >
              Me contacter
            </a>
          </div>
        </div>

        <!-- Footer -->
        <Footer currentPath={`/projets/${project.slug}`} />

      </main>

    </div>

  </div>
</Layout>
