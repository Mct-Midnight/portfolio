---
// Page d'erreur HTTP 404 sur mesure - Version équilibrée et pleine page sans défilement
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import profileData from '../content/data/profile.json';
import { ArrowLeft, Terminal } from 'lucide-astro';

const { identity } = profileData;
---

<Layout
  title={`404 — Page Introuvable | ${identity.firstName} ${identity.lastName}`}
  description="La page demandée est introuvable sur l'infrastructure Vercel du portfolio de Quentin Machu, étudiant en BTS SIO SLAM."
>
  <!-- Conteneur global occupant la pleine hauteur d'écran sans défilement sur ordinateur -->
  <div class="flex min-h-screen lg:h-screen lg:max-h-screen lg:overflow-hidden bg-slate-50 dark:bg-[#09090b] transition-colors duration-200">
    
    <!-- Barre latérale fixe (Desktop 260px + Tiroir Mobile réactif) -->
    <Sidebar currentPath="/404" />

    <!-- Zone principale occupant exactement l'espace restant -->
    <div class="flex-1 w-full lg:pl-[280px] flex flex-col h-full lg:max-h-screen min-w-0">
      
      <!-- Conteneur principal harmonisé sur la grille de la page d'accueil (max-w-5xl) -->
      <main class="flex-1 max-w-5xl w-full mx-auto px-5 sm:px-8 lg:px-12 pt-14 lg:pt-8 pb-6 sm:pb-8 flex flex-col justify-between h-full">
        
        <!-- Bloc central valorisé prenant une présence généreuse et harmonieuse -->
        <div class="my-auto py-2 sm:py-3 flex flex-col items-center text-center">
          
          <!-- 1. Grand 404 Montserrat imposant avec espacement symétrique calibré entre chaque chiffre -->
          <div class="select-none mb-2 sm:mb-3 flex items-center justify-center gap-2 sm:gap-4 lg:gap-5 font-title font-black text-8xl sm:text-9xl lg:text-[10rem] xl:text-[11rem] text-zinc-400 dark:text-zinc-700 leading-none">
            <span>4</span>
            <span>0</span>
            <span>4</span>
          </div>

          <!-- 2. Titre principal exécutif de belle stature -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-title text-slate-900 dark:text-zinc-100 tracking-tight max-w-2xl mb-2.5 sm:mb-3">
            Cette page n'existe pas ou a été déplacée
          </h1>

          <!-- 3. Sous-titre pédagogique équilibré -->
          <p class="text-sm sm:text-base text-slate-600 dark:text-zinc-400 leading-relaxed max-w-xl mx-auto mb-5 sm:mb-6">
            L'URL demandée n'a pas été trouvée sur l'infrastructure Vercel hébergeant ce portfolio statique. Le lien est peut-être erroné, obsolète ou a fait l'objet d'une réorganisation d'arborescence.
          </p>

          <!-- 4. Cartouche de diagnostic technique élargi au format terminal -->
          <div class="w-full max-w-xl bg-[#18181B] dark:bg-[#121215] border border-zinc-800 rounded-2xl overflow-hidden shadow-card text-left mb-6 sm:mb-7">
            <!-- Barre supérieure de fenêtre terminal -->
            <div class="px-4 py-2.5 bg-zinc-900/90 border-b border-zinc-800 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500" title="Fermer"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400/90" title="Réduire"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/90" title="Agrandir"></span>
                <span class="ml-2 text-xs font-mono text-zinc-400">diagnostic-route.log</span>
              </div>
              <div class="flex items-center gap-1.5 text-zinc-500">
                <Terminal class="w-3.5 h-3.5" />
                <span class="text-[10px] font-mono uppercase tracking-wider">SSG Edge</span>
              </div>
            </div>

            <!-- Lignes de logs du diagnostic avec lisibilité accrue -->
            <div class="p-4 sm:p-5 font-mono text-xs sm:text-sm space-y-2 text-zinc-300">
              <div class="flex items-start gap-2.5">
                <span class="text-zinc-500 select-none shrink-0">$</span>
                <div class="flex flex-col sm:flex-row sm:gap-2">
                  <span class="text-zinc-400">Code statut :</span>
                  <span class="text-amber-400 font-semibold">404 Not Found</span>
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-zinc-500 select-none shrink-0">$</span>
                <div class="flex flex-col sm:flex-row sm:gap-2">
                  <span class="text-zinc-400">Routage :</span>
                  <span class="text-zinc-200">Astro 5 SSG / Vercel Edge Network</span>
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-zinc-500 select-none shrink-0">$</span>
                <div class="flex flex-col sm:flex-row sm:gap-2">
                  <span class="text-zinc-400">Action recommandée :</span>
                  <span class="text-emerald-400 font-medium">Redirection vers une route valide</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 5. Bouton d'action principal bien proportionné avec marge inférieure de confort -->
          <div class="flex items-center justify-center pb-2">
            <a
              href="/"
              class="inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-zinc-900 hover:bg-black text-white dark:bg-zinc-100 dark:hover:bg-white dark:text-zinc-950 font-semibold text-sm transition-all shadow-sm hover:shadow-md group"
            >
              <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
              <span>Revenir à l'accueil</span>
            </a>
          </div>

        </div>

        <!-- 6. Pied de page aéré avec marge de respiration et largeur identique à l'accueil -->
        <div class="shrink-0 w-full mt-6 lg:mt-8 pt-3 border-t border-slate-200/80 dark:border-zinc-800/80 [&>footer]:mt-0 [&>footer]:py-3 [&>footer]:border-t-0">
          <Footer currentPath="/404" hideHomeLink={true} />
        </div>

      </main>

    </div>

  </div>
</Layout>
