---
// Page d'erreur HTTP 404 sur mesure du Portfolio BTS SIO SLAM
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import profileData from '../content/data/profile.json';
import {
  ArrowLeft,
  Briefcase,
  GitBranch,
  Terminal,
  Compass,
  AlertCircle
} from 'lucide-astro';

const { identity } = profileData;
---

<Layout
  title={`404 — Page Introuvable | ${identity.firstName} ${identity.lastName}`}
  description="La page demandée est introuvable sur l'infrastructure Vercel du portfolio de Quentin Machu, étudiant en BTS SIO SLAM."
>
  <div class="flex min-h-screen bg-slate-50 dark:bg-[#09090b] transition-colors duration-200">
    
    <!-- Barre latérale fixe (Desktop 260px + Tiroir Mobile réactif) -->
    <Sidebar currentPath="/404" />

    <!-- Zone principale de contenu -->
    <div class="flex-1 w-full lg:pl-[280px] flex flex-col min-w-0">
      
      <main class="flex-1 max-w-4xl w-full mx-auto px-5 sm:px-8 lg:px-10 pt-20 lg:pt-12 pb-16 flex flex-col justify-between">
        
        <!-- Contenu central de la page 404 -->
        <div class="my-auto py-8 sm:py-12 flex flex-col items-center text-center">
          
          <!-- 1. En-tête de statut avec voyant ambré feutré -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-400 border border-amber-500/20 shadow-sm mb-6">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span>
            <span>Erreur HTTP 404 • Ressource Introuvable</span>
          </div>

          <!-- 2. Impact visuel exécutif : Grand 404 Montserrat et titres -->
          <div class="relative select-none mb-2">
            <span class="font-title font-black text-8xl sm:text-9xl md:text-[11rem] tracking-tighter text-zinc-200 dark:text-zinc-800 leading-none block">
              404
            </span>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="p-3 sm:p-4 rounded-2xl bg-white/80 dark:bg-[#18181B]/80 backdrop-blur-md border border-slate-200/80 dark:border-[#27272A] shadow-card">
                <Compass class="w-7 h-7 sm:w-9 sm:h-9 text-zinc-900 dark:text-zinc-100" />
              </span>
            </div>
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-title text-slate-900 dark:text-zinc-100 tracking-tight max-w-2xl mt-2 mb-4">
            Cette page n'existe pas ou a été déplacée
          </h1>

          <p class="text-sm sm:text-base text-slate-600 dark:text-zinc-400 leading-relaxed max-w-xl mx-auto mb-8">
            L'URL demandée n'a pas été trouvée sur l'infrastructure Vercel hébergeant ce portfolio statique. Le lien est peut-être erroné, obsolète ou a fait l'objet d'une réorganisation d'arborescence.
          </p>

          <!-- 3. Cartouche de diagnostic technique au format terminal -->
          <div class="w-full max-w-lg bg-[#18181B] dark:bg-[#121215] border border-zinc-800 rounded-2xl overflow-hidden shadow-card text-left mb-10">
            <!-- Barre supérieure du terminal -->
            <div class="px-4 py-2.5 bg-zinc-900/90 border-b border-zinc-800 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="ml-2 text-[11px] font-mono text-zinc-400">diagnostic-route.log</span>
              </div>
              <div class="flex items-center gap-1.5 text-zinc-500">
                <Terminal class="w-3.5 h-3.5" />
                <span class="text-[10px] font-mono uppercase tracking-wider">SSG Edge</span>
              </div>
            </div>

            <!-- Lignes de logs du diagnostic -->
            <div class="p-4 sm:p-5 font-mono text-xs space-y-2.5 text-zinc-300">
              <div class="flex items-start gap-2">
                <span class="text-zinc-500 select-none shrink-0">$</span>
                <div class="flex flex-col sm:flex-row sm:gap-2">
                  <span class="text-zinc-400">Code statut :</span>
                  <span class="text-amber-400 font-semibold">404 Not Found</span>
                </div>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-zinc-500 select-none shrink-0">$</span>
                <div class="flex flex-col sm:flex-row sm:gap-2">
                  <span class="text-zinc-400">Routage :</span>
                  <span class="text-zinc-200">Astro 5 SSG / Vercel Edge Network</span>
                </div>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-zinc-500 select-none shrink-0">$</span>
                <div class="flex flex-col sm:flex-row sm:gap-2">
                  <span class="text-zinc-400">Action recommandée :</span>
                  <span class="text-emerald-400 font-medium">Redirection vers une route valide</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. Boutons d'action (Call-To-Action) -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 w-full max-w-md">
            <!-- Bouton principal : Retour à l'accueil -->
            <a
              href="/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-zinc-900 hover:bg-black text-white dark:bg-zinc-100 dark:hover:bg-white dark:text-zinc-950 font-semibold text-sm transition-all shadow-sm group"
            >
              <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
              <span>Revenir à l'accueil</span>
            </a>

            <!-- Bouton secondaire : Projets E4 -->
            <a
              href="/#projets"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white dark:bg-[#18181B] hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold text-sm border border-zinc-300 dark:border-zinc-700 transition-all shadow-sm"
            >
              <Briefcase class="w-4 h-4 text-zinc-700 dark:text-zinc-300" />
              <span>Explorer les projets E4</span>
            </a>
          </div>

          <!-- Lien tertiaire discret : Journal Git -->
          <div class="mt-6">
            <a
              href="/journal"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 underline decoration-zinc-300 dark:decoration-zinc-700 underline-offset-4 transition-colors"
            >
              <GitBranch class="w-3.5 h-3.5" />
              <span>Consulter le journal Git</span>
            </a>
          </div>

        </div>

        <!-- 5. Pied de page contextuel -->
        <Footer currentPath="/404" />

      </main>

    </div>

  </div>
</Layout>
