---
// Page dédiée au Journal de bord et à la traçabilité des commits Git
// Valorisation du Bloc 1 du BTS SIO (Gestion du patrimoine informatique et démarche qualité)
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import profileData from '../content/data/profile.json';
import { getGitCommits } from '../utils/gitCommits';
import {
  ArrowLeft,
  GitCommit,
  GitBranch,
  ExternalLink,
  CheckCircle2,
  Calendar,
  Layers,
  Sparkles,
  ShieldCheck,
  Tag
} from 'lucide-astro';

// Récupération asynchrone des commits lors de la génération de la page Astro
const commits = await getGitCommits();
const { identity, contact } = profileData;

// Calcul des statistiques pour le bandeau supérieur
const totalCommits = commits.length;
const featCount = commits.filter((c) => c.type === 'feat').length;
const fixCount = commits.filter((c) => c.type === 'fix').length;
const choreCount = commits.filter((c) => c.type === 'chore').length;
const otherCount = totalCommits - (featCount + fixCount + choreCount);
const latestCommit = commits[0];
---

<Layout
  title={`Journal des Évolutions & Activité Git — ${identity.firstName} ${identity.lastName}`}
  description="Historique des livraisons Git, commits conventionnels et suivi de version du portfolio BTS SIO SLAM de Quentin Machu."
>
  <div class="flex min-h-screen bg-slate-50">
    <!-- Barre latérale fixe -->
    <Sidebar currentPath="/journal" />

    <!-- Zone principale -->
    <div class="flex-1 w-full lg:pl-[260px] flex flex-col min-w-0">
      <main class="flex-1 max-w-4xl w-full mx-auto px-5 sm:px-8 lg:px-10 pt-20 lg:pt-10 pb-16">
        
        <!-- Bouton retour vers l'accueil -->
        <div class="mb-6">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-xs font-bold font-title text-slate-900 hover:text-zinc-950 transition-colors py-2 px-3 rounded-lg hover:bg-white border border-transparent hover:border-slate-200"
          >
            <ArrowLeft class="w-4 h-4 text-zinc-900" />
            <span>Retour à l'accueil du portfolio</span>
          </a>
        </div>

        <!-- En-tête principal : Contexte BTS SIO et Traçabilité -->
        <header class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-card mb-8 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <span class="p-2 bg-zinc-100 text-zinc-900 rounded-xl border border-zinc-200">
                <GitBranch class="w-5 h-5" />
              </span>
              <span class="text-xs font-bold text-zinc-900 uppercase tracking-widest font-title">
                Bloc 1 BTS SIO · Gestion du Patrimoine Informatique
              </span>
            </div>

            <!-- Lien vers le dépôt GitHub public -->
            <a
              href={contact.github + '/portfolio'}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-colors"
            >
              <span>Dépôt sur GitHub</span>
              <ExternalLink class="w-3.5 h-3.5 opacity-80" />
            </a>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold font-title text-slate-900 tracking-tight">
            Journal de Bord & Traçabilité Git
          </h1>

          <p class="text-sm text-slate-600 leading-relaxed">
            Ce journal retrace en toute transparence l'historique des modifications apportées au portfolio.
            Chaque mise à jour respecte une méthodologie professionnelle : vérification de la compilation,
            découpage atomique des commits et messages conventionnels rédigés en français.
          </p>

          <!-- Bandeau de statistiques clés (KPI) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-slate-100">
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
              <span class="text-xs text-slate-500 font-medium block">Total livraisons</span>
              <span class="text-xl font-extrabold text-slate-900 font-title">{totalCommits} commits</span>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
              <span class="text-xs text-slate-500 font-medium block">Fonctionnalités</span>
              <span class="text-xl font-extrabold text-emerald-600 font-title">{featCount} ajouts</span>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
              <span class="text-xs text-slate-500 font-medium block">Correctifs</span>
              <span class="text-xl font-extrabold text-amber-600 font-title">{fixCount} correctifs</span>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
              <span class="text-xs text-slate-500 font-medium block">Dernière mise à jour</span>
              <span class="text-xs font-bold text-zinc-900 font-title truncate block mt-1" title={latestCommit ? latestCommit.formattedDate : ''}>
                {latestCommit ? latestCommit.relativeDate : 'Récemment'}
              </span>
            </div>
          </div>
        </header>

        <!-- Filtres interactifs par catégorie de commit -->
        <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6" id="commit-filters">
          <button
            type="button"
            data-filter="all"
            class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-zinc-900 text-white shadow-sm transition-all"
          >
            Tous ({totalCommits})
          </button>
          <button
            type="button"
            data-filter="feat"
            class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-300 transition-all"
          >
            Fonctionnalités ({featCount})
          </button>
          <button
            type="button"
            data-filter="fix"
            class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-300 transition-all"
          >
            Correctifs ({fixCount})
          </button>
          <button
            type="button"
            data-filter="chore"
            class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-300 transition-all"
          >
            Maintenance ({choreCount})
          </button>
          {otherCount > 0 && (
            <button
              type="button"
              data-filter="other"
              class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-300 transition-all"
            >
              Autres ({otherCount})
            </button>
          )}
        </div>

        <!-- Liste chronologique des commits -->
        <div class="space-y-4 relative before:absolute before:inset-0 before:left-4 sm:before:left-5 before:w-0.5 before:bg-slate-200 before:pointer-events-none" id="commits-container">
          {commits.map((commit, index) => (
            <div
              class="commit-card relative flex items-start gap-4 sm:gap-5 pl-1"
              data-type={commit.type}
            >
              <!-- Puce d'étape sur la ligne chronologique -->
              <div class="relative z-10 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white border-2 border-slate-300 flex items-center justify-center shrink-0 shadow-sm mt-1">
                <span class={`w-2.5 h-2.5 rounded-full ${commit.typeDot}`}></span>
              </div>

              <!-- Carte détaillée du commit -->
              <div class="flex-1 bg-white rounded-xl p-4 sm:p-5 border border-slate-200 shadow-card hover:border-zinc-300 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-2.5">
                  
                  <!-- Badges : Type et Domaine -->
                  <div class="flex items-center flex-wrap gap-2">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold border ${commit.typeBadge}`}>
                      {commit.typeLabel}
                    </span>

                    {commit.scope && (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                        <Tag class="w-3 h-3 text-slate-400" />
                        <span>{commit.scope}</span>
                      </span>
                    )}

                    <!-- Indicateur de branche -->
                    <span class="text-[10px] text-slate-400 font-mono flex items-center gap-1">
                      <GitBranch class="w-3 h-3" />
                      main
                    </span>
                  </div>

                  <!-- Hash et lien vers GitHub -->
                  <div class="flex items-center gap-2">
                    <a
                      href={commit.commitUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-slate-100 hover:bg-zinc-100 text-slate-700 hover:text-zinc-950 font-mono text-xs transition-colors group"
                      title="Consulter ce commit sur GitHub"
                    >
                      <GitCommit class="w-3.5 h-3.5 text-slate-400 group-hover:text-zinc-950" />
                      <span>{commit.hash}</span>
                      <ExternalLink class="w-3 h-3 opacity-60 group-hover:opacity-100" />
                    </a>
                  </div>
                </div>

                <!-- Description explicite du commit en français -->
                <p class="text-sm font-semibold text-slate-900 leading-snug">
                  {commit.description}
                </p>

                <!-- Pied de carte : Date et auteur -->
                <div class="flex items-center justify-between flex-wrap gap-2 pt-3 mt-3 border-t border-slate-100 text-xs text-slate-400">
                  <span class="flex items-center gap-1.5">
                    <Calendar class="w-3.5 h-3.5 text-slate-400" />
                    <span class="font-medium text-slate-600">{commit.formattedDate}</span>
                    <span class="text-slate-300">·</span>
                    <span class="text-slate-500 font-medium">{commit.relativeDate}</span>
                  </span>

                  <span class="text-slate-500">
                    Auteur : <span class="font-semibold text-slate-700">{commit.author}</span>
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Encadré méthodologique et pédagogique pour le jury BTS SIO -->
        <section class="mt-12 bg-zinc-50 rounded-2xl p-6 sm:p-7 border border-zinc-200 shadow-soft">
          <div class="flex items-start gap-4">
            <span class="p-2.5 bg-zinc-900 text-white rounded-xl shadow-sm shrink-0">
              <ShieldCheck class="w-6 h-6" />
            </span>
            <div class="space-y-2">
              <h2 class="text-base font-bold text-slate-900 font-title">
                Démarche de Gestion de Configuration & Qualité Logicielle (Épreuve E4)
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Ce journal de bord témoigne de la régularité et de la rigueur appliquées dans le cadre du
                <strong>Bloc 1 du BTS SIO</strong>. Chaque livraison suit un protocole strict :
              </p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 text-xs text-slate-700">
                <li class="flex items-center gap-2">
                  <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                  <span>Validation systématique de la compilation (Build Astro)</span>
                </li>
                <li class="flex items-center gap-2">
                  <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                  <span>Commits atomiques groupés par domaine fonctionnel</span>
                </li>
                <li class="flex items-center gap-2">
                  <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                  <span>Messages normalisés en français (Conventional Commits)</span>
                </li>
                <li class="flex items-center gap-2">
                  <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                  <span>Traçabilité complète sur dépôt distant GitHub</span>
                </li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Pied de page contextuel centré avec le contenu -->
        <Footer currentPath="/journal" />

      </main>
    </div>
  </div>
</Layout>

<!-- Script interactif de filtrage des commits côté client -->
<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const commitCards = document.querySelectorAll<HTMLElement>('.commit-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Mise à jour de l'apparence des boutons de filtre
      filterButtons.forEach((b) => {
        b.classList.remove('bg-zinc-900', 'text-white');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.add('bg-zinc-900', 'text-white');
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');

      // Filtrage des cartes
      commitCards.forEach((card) => {
        const type = card.getAttribute('data-type');
        if (filter === 'all') {
          card.style.display = 'flex';
        } else if (filter === 'other') {
          if (type !== 'feat' && type !== 'fix' && type !== 'chore') {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        } else if (type === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
