---
// Page dédiée : Fiche de Synthèse Entreprise & RH (Stage 2027)
// Conçue pour lever tous les freins administratifs et financiers lors de la recherche de stage 1re année SLAM.
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import profileData from '../content/data/profile.json';
import {
  ArrowLeft,
  Printer,
  Laptop,
  Database,
  Workflow,
  ClipboardCheck,
  MapPin,
  Phone,
  Mail,
  Linkedin,
  Download,
  ArrowUpRight,
  BadgeEuro,
  Calendar,
  ShieldCheck
} from 'lucide-astro';

const { identity, contact, internshipSearch } = profileData;
---

<Layout
  title={`Fiche de Synthèse Stage 2027 — ${identity.firstName} ${identity.lastName}`}
  description="Fiche de synthèse pour l'entreprise d'accueil : cadre juridique conventionné, gratification facultative, calendrier modulable et compétences en développement de Quentin Machu (BTS SIO SLAM)."
>
  <!-- =========================================================================
       1. VERSION ÉCRAN (Interactive, responsive, avec Sidebar et thème sombre)
       Masquée à 100% lors de l'impression physique ou export PDF.
       ========================================================================= -->
  <div class="screen-only-layout flex min-h-screen bg-slate-50 dark:bg-[#09090b] transition-colors duration-200">
    
    <!-- Barre latérale fixe -->
    <Sidebar currentPath="/fiche-synthese-stage" />

    <!-- Zone principale de contenu pour affichage écran -->
    <div class="flex-1 w-full lg:pl-[280px] flex flex-col min-w-0">
      
      <main class="flex-1 max-w-4xl w-full mx-auto px-5 sm:px-8 lg:px-10 pt-20 lg:pt-10 pb-16">
        
        <!-- Barre supérieure d'actions (Retour accueil & Impression PDF) -->
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-xs font-bold font-title text-slate-900 dark:text-zinc-100 hover:text-zinc-950 dark:hover:text-white transition-colors py-2 px-3 rounded-lg hover:bg-white dark:hover:bg-zinc-900 border border-transparent hover:border-slate-200 dark:hover:border-zinc-800"
          >
            <ArrowLeft class="w-4 h-4 text-zinc-900 dark:text-zinc-100" />
            <span>Retour à l'accueil du portfolio</span>
          </a>

          <button
            type="button"
            id="print-synthese-btn"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 shadow-sm transition-colors cursor-pointer"
            title="Imprimer ou enregistrer cette fiche au format PDF (1 page A4)"
          >
            <Printer class="w-4 h-4 text-zinc-700 dark:text-zinc-300" />
            <span>Imprimer la fiche en PDF (1 page A4)</span>
          </button>
        </div>

        <!-- En-tête principal écran exécutif -->
        <header class="bg-white dark:bg-[#18181B] rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 mb-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Document RH & Direction</span>
            </span>
            <span class="text-xs text-slate-400 dark:text-zinc-500 font-medium">
              Stage 1re Année SLAM · 2027
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold font-title text-slate-900 dark:text-zinc-100 tracking-tight">
            Fiche de synthèse pour l'entreprise d'accueil
          </h1>

          <p class="text-sm sm:text-base text-slate-600 dark:text-zinc-400 leading-relaxed max-w-3xl">
            Candidature de <strong>{identity.firstName} {identity.lastName}</strong> pour un stage conventionné au CNED.
            Ce document récapitule de manière claire et transparente le cadre administratif, l'absence d'obligation financière et les compétences techniques directement opérationnelles.
          </p>

          <!-- Bandeau de métadonnées exécutives -->
          <div class="pt-3 border-t border-slate-100 dark:border-zinc-800 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-600 dark:text-zinc-400">
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900 dark:text-zinc-200 font-title">Période cible :</span>
              <span>Mai à Août 2027</span>
            </div>
            <div class="hidden sm:block w-1 h-1 rounded-full bg-slate-300 dark:bg-zinc-700"></div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900 dark:text-zinc-200 font-title">Format :</span>
              <span>4 à 5 semaines (35h / sem.)</span>
            </div>
            <div class="hidden sm:block w-1 h-1 rounded-full bg-slate-300 dark:bg-zinc-700"></div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900 dark:text-zinc-200 font-title">Convention :</span>
              <span>Tripartite CNED</span>
            </div>
          </div>
        </header>

        <!-- Section A écran : Paramètres clés & Cadre administratif en 3 cartes -->
        <section class="mb-8">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500 mb-4 font-title">
            Cadre Administratif & Modalités d'Accueil
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-stretch">
            
            <!-- Carte 1 : Gratification légale -->
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col justify-between h-full group cursor-default">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0 transition-transform group-hover:scale-110">
                    <BadgeEuro class="w-5 h-5" />
                  </div>
                  <span class="text-[11px] font-semibold tracking-wide uppercase px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700">
                    Zéro contrainte
                  </span>
                </div>
                <h2 class="font-bold text-base text-slate-900 dark:text-zinc-100 font-title mb-1">
                  Gratification Facultative
                </h2>
                <div class="text-2xl font-black font-title tracking-tight text-slate-900 dark:text-white mb-2">
                  0 € imposé
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed">
                  Durée de stage inférieure au seuil légal de 2 mois consécutifs (308h - art. L124-6 du Code de l'éducation). Gratification facultative sans charge financière imposée.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-zinc-800/80 text-[11px] text-slate-400 dark:text-zinc-500 font-medium">
                Prime discrétionnaire laissée au libre choix
              </div>
            </div>

            <!-- Carte 2 : Durée & Calendrier -->
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col justify-between h-full group cursor-default">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0 transition-transform group-hover:scale-110">
                    <Calendar class="w-5 h-5" />
                  </div>
                  <span class="text-[11px] font-semibold tracking-wide uppercase px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700">
                    Temps plein
                  </span>
                </div>
                <h2 class="font-bold text-base text-slate-900 dark:text-zinc-100 font-title mb-1">
                  Calendrier Modulable
                </h2>
                <div class="text-2xl font-black font-title tracking-tight text-slate-900 dark:text-white mb-2">
                  4 à 5 semaines
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed">
                  Période cible de Mai à Août 2027 (35h / semaine). Dates modulables selon les disponibilités et les jalons de vos projets en entreprise.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-zinc-800/80 text-[11px] text-slate-400 dark:text-zinc-500 font-medium">
                Période adaptable selon vos besoins
              </div>
            </div>

            <!-- Carte 3 : Cadre légal & Convention -->
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col justify-between h-full group cursor-default">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0 transition-transform group-hover:scale-110">
                    <ShieldCheck class="w-5 h-5" />
                  </div>
                  <span class="text-[11px] font-semibold tracking-wide uppercase px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700">
                    CNED officiel
                  </span>
                </div>
                <h2 class="font-bold text-base text-slate-900 dark:text-zinc-100 font-title mb-1">
                  Sécurité Contractuelle
                </h2>
                <div class="text-2xl font-black font-title tracking-tight text-slate-900 dark:text-white mb-2">
                  100% Encadré
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed">
                  Convention tripartite officielle émise par le CNED. Étudiant couvert par l'assurance scolaire et la responsabilité civile.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-zinc-800/80 text-[11px] text-slate-400 dark:text-zinc-500 font-medium">
                Signature dématérialisée rapide sous 48h
              </div>
            </div>

          </div>
        </section>

        <!-- Section B écran : Missions & Compétences Opérationnelles -->
        <section class="mb-8">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500 mb-4 font-title">
            Missions & Compétences Directes (1re Année SLAM)
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-stretch">
            
            <!-- Compétence 1 : Front-End -->
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col justify-between h-full group cursor-default">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0 transition-transform group-hover:scale-110">
                  <Laptop class="w-5 h-5" />
                </div>
                <h2 class="font-bold text-base text-slate-900 dark:text-zinc-100 font-title">
                  Front-End & Intégration Web
                </h2>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed flex-1">
                Conception d'interfaces web responsives et modernes, intégration rigoureuse de maquettes et composants UI réutilisables.
              </p>
            </div>

            <!-- Compétence 2 : Bases de données -->
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col justify-between h-full group cursor-default">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0 transition-transform group-hover:scale-110">
                  <Database class="w-5 h-5" />
                </div>
                <h2 class="font-bold text-base text-slate-900 dark:text-zinc-100 font-title">
                  Bases de Données & Requêtes SQL
                </h2>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed flex-1">
                Modélisation relationnelle (MCD/MLD), écriture de requêtes SQL optimisées, contrôle d'intégrité et manipulation de données.
              </p>
            </div>

            <!-- Compétence 3 : Automatisation & Python -->
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col justify-between h-full group cursor-default">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0 transition-transform group-hover:scale-110">
                  <Workflow class="w-5 h-5" />
                </div>
                <h2 class="font-bold text-base text-slate-900 dark:text-zinc-100 font-title">
                  Automatisation & Scripts Utilitaires
                </h2>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed flex-1">
                Création de scripts d'automatisation en Python, traitement de flux de données (JSON/CSV) et connexion aux APIs REST.
              </p>
            </div>

            <!-- Compétence 4 : Recette & Tests -->
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col justify-between h-full group cursor-default">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0 transition-transform group-hover:scale-110">
                  <ClipboardCheck class="w-5 h-5" />
                </div>
                <h2 class="font-bold text-base text-slate-900 dark:text-zinc-100 font-title">
                  Recette, Tests & Documentation
                </h2>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed flex-1">
                Exécution de plans de tests fonctionnels, recette des écrans utilisateurs, rédaction de guides réflexes et fiches techniques.
              </p>
            </div>

          </div>
        </section>

        <!-- Section C écran : Modalités de travail & Mobilité -->
        <section class="mb-8">
          <div class="bg-white dark:bg-[#18181B] rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-10 text-xs sm:text-sm whitespace-nowrap">
            <div class="flex items-center gap-2.5 text-slate-700 dark:text-zinc-300">
              <MapPin class="w-4 h-4 text-zinc-900 dark:text-zinc-100 shrink-0" />
              <span><strong>Présentiel :</strong> Cambrai (Hauts-de-France)</span>
            </div>
            <div class="hidden sm:block w-px h-4 bg-slate-200 dark:bg-zinc-800" aria-hidden="true"></div>
            <div class="flex items-center gap-2.5 text-slate-700 dark:text-zinc-300">
              <Laptop class="w-4 h-4 text-zinc-900 dark:text-zinc-100 shrink-0" />
              <span><strong>Télétravail :</strong> Hybride possible (1 à 2 jours max / semaine)</span>
            </div>
          </div>
        </section>

        <!-- Section D écran : Contact direct du candidat & Téléchargement CV -->
        <section class="mb-10">
          <div class="bg-zinc-900 dark:bg-[#18181B] text-white rounded-2xl p-6 sm:p-8 border border-zinc-800 shadow-card hover:shadow-card-hover hover:border-zinc-700 transition-all duration-200 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-2">
              <h2 class="text-lg font-bold font-title text-white">
                Contact Direct du Candidat
              </h2>
              <p class="text-xs sm:text-sm text-zinc-400">
                Disponible pour échanger sur vos opportunités de stage ou convenir d'un entretien technique.
              </p>

              <!-- Coordonnées cliquables -->
              <div class="pt-2 flex flex-wrap items-center gap-4 sm:gap-6 text-xs text-zinc-300">
                <a
                  href={`tel:${contact.phone.replace(/\s+/g, '')}`}
                  class="flex items-center gap-1.5 hover:text-white transition-colors"
                >
                  <Phone class="w-4 h-4 text-zinc-400" />
                  <span>{contact.phone}</span>
                </a>

                <a
                  href={`mailto:${contact.email}`}
                  class="flex items-center gap-1.5 hover:text-white transition-colors"
                >
                  <Mail class="w-4 h-4 text-zinc-400" />
                  <span>{contact.email}</span>
                </a>

                <a
                  href={contact.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1 hover:text-white transition-colors text-zinc-400"
                >
                  <Linkedin class="w-4 h-4" />
                  <span>Profil LinkedIn</span>
                  <ArrowUpRight class="w-3 h-3" />
                </a>
              </div>
            </div>

            <!-- Bouton de téléchargement du CV -->
            <div class="shrink-0">
              <a
                href={identity.cvDownloadUrl}
                download
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-zinc-100 text-zinc-950 font-semibold text-xs sm:text-sm transition-all shadow-sm"
              >
                <Download class="w-4 h-4" />
                <span>Télécharger le CV</span>
              </a>
            </div>
          </div>
        </section>

        <!-- Pied de page du site -->
        <Footer currentPath="/fiche-synthese-stage" />

      </main>

    </div>

  </div>

  <!-- =========================================================================
       2. DOCUMENT IMPRIMABLE EXCLUSIF (Format A4 standardisé sur 1 seule page)
       Activé automatiquement lors du clic sur Imprimer ou du raccourci Ctrl+P.
       ========================================================================= -->
  <div class="print-only-document">
    
    <!-- En-tête officiel de la fiche imprimable -->
    <header class="border-b border-zinc-300 pb-3 mb-2.5 print-avoid-break">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-zinc-500 font-title">
            <span>Candidature de Stage 2027</span>
            <span>•</span>
            <span class="text-zinc-800 font-extrabold">BTS SIO (Option SLAM)</span>
          </div>
          <h1 class="text-xl font-black font-title tracking-tight text-zinc-950 mt-0.5">
            {identity.firstName} {identity.lastName}
          </h1>
          <p class="text-[11px] font-medium text-zinc-700 mt-0.5">
            Développeur d'applications & web — Première Année · Formation en autonomie ({identity.institution})
          </p>
        </div>

        <!-- Coordonnées directes compactes -->
        <div class="text-right text-[10.5px] text-zinc-700 space-y-0.5 shrink-0">
          <div class="font-extrabold text-zinc-950 text-xs">{contact.phone}</div>
          <div class="font-medium text-zinc-800">{contact.email}</div>
          <div class="text-zinc-600">{contact.city}</div>
          <div class="text-[9.5px] font-mono text-zinc-500 pt-0.5">quentin-machu-portfolio.vercel.app</div>
        </div>
      </div>

      <!-- Bandeau Titre Officiel & Disponibilité -->
      <div class="mt-2 pt-2 border-t border-zinc-200 flex items-center justify-between">
        <h2 class="text-xs font-extrabold uppercase tracking-wide text-zinc-950 font-title">
          Fiche de synthèse pour l'entreprise d'accueil & Ressources Humaines
        </h2>
        <span class="text-[9.5px] font-bold bg-zinc-100 text-zinc-900 px-2 py-0.5 rounded border border-zinc-300">
          Période : {internshipSearch.period} ({internshipSearch.duration})
        </span>
      </div>
    </header>

    <!-- Résumé exécutif de cadrage -->
    <div class="mb-2.5 text-[10.5px] text-zinc-700 leading-snug print-avoid-break">
      Candidature de <strong>{identity.firstName} {identity.lastName}</strong> pour un stage conventionné de première année (SLAM).
      Ce document officiel récapitule avec rigueur le cadre administratif, l'absence d'obligation financière et les compétences techniques directement opérationnelles.
    </div>

    <!-- 1. Section cadre en 3 points clés (Boîte 3 colonnes) -->
    <section class="mb-2.5 print-avoid-break">
      <div class="text-[10px] font-bold uppercase tracking-wider text-zinc-500 mb-1 font-title">
        1. Le Cadre Administratif & Financier en 3 Points Clés
      </div>

      <div class="grid grid-cols-3 border border-zinc-300 rounded-lg overflow-hidden bg-zinc-50/60 divide-x divide-zinc-300">
        
        <!-- Point 1 : Gratification légale -->
        <div class="p-2.5 flex flex-col justify-between">
          <div>
            <div class="text-base font-black text-zinc-950 font-title tracking-tight leading-none">
              0 € imposé
            </div>
            <div class="text-[9.5px] font-bold uppercase text-zinc-700 mt-1">
              Gratification facultative
            </div>
            <p class="text-[9.5px] text-zinc-600 mt-1 leading-snug">
              Durée inférieure au seuil légal de 2 mois consécutifs (308h - art. L124-6 du Code de l'éducation). Zéro charge financière obligatoire.
            </p>
          </div>
          <div class="text-[9px] font-bold text-zinc-500 mt-1.5 pt-1 border-t border-zinc-200/80">
            Zéro coût imposé
          </div>
        </div>

        <!-- Point 2 : Durée & Calendrier -->
        <div class="p-2.5 flex flex-col justify-between">
          <div>
            <div class="text-base font-black text-zinc-950 font-title tracking-tight leading-none">
              4 à 5 sem.
            </div>
            <div class="text-[9.5px] font-bold uppercase text-zinc-700 mt-1">
              Calendrier modulable
            </div>
            <p class="text-[9.5px] text-zinc-600 mt-1 leading-snug">
              Période cible : Mai à Août 2027. Dates et calendrier modulables selon les disponibilités et les jalons de vos projets en entreprise.
            </p>
