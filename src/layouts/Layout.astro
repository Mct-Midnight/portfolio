---
// Layout principal du Portfolio BTS SIO SLAM
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Quentin Machu — Développeur Logiciel & Portfolio",
  description = "Portfolio professionnel et réalisations techniques de Quentin Machu, développeur logiciel et étudiant en BTS SIO option SLAM auprès du CNED.",
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Métadonnées SEO et Référencement -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Quentin Machu" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph & Twitter Cards -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Polices Google Fonts : Montserrat (Black / ExtraBold) pour des titres imposants et Plus Jakarta Sans pour le texte -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Devicon officiel pour les logos technologiques -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
  </head>
  <body class="bg-slate-50 text-slate-700 antialiased selection:bg-zinc-900 selection:text-white font-sans">
    <slot />
  </body>
</html>
