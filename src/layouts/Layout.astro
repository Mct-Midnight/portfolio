---
// Layout principal du Portfolio BTS SIO SLAM
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import AuditInspector from '../components/AuditInspector.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Quentin Machu — Développeur Logiciel & Portfolio",
  description = "Portfolio professionnel et réalisations techniques de Quentin Machu, développeur logiciel et étudiant en BTS SIO option SLAM auprès du CNED.",
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Métadonnées SEO et Référencement -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Quentin Machu" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph & Partage Réseaux Sociaux -->
    <meta property="og:site_name" content="Portfolio BTS SIO — Quentin Machu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL('/assets/images/og-preview.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Quentin Machu — Portfolio Développeur Logiciel BTS SIO SLAM" />

    <!-- Twitter Cards (Format large image) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/assets/images/og-preview.png', Astro.site).href} />


    <!-- Polices Google Fonts : Montserrat (Black / ExtraBold) pour des titres imposants et Plus Jakarta Sans pour le texte -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Devicon officiel pour les logos technologiques -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />

    <!-- Initialisation immédiate du thème (Mode clair par défaut pour tous, avec mémorisation du choix) -->
    <script is:inline>
      (function() {
        try {
          const storedTheme = localStorage.getItem('portfolio-theme');
          // Le portfolio démarre d'office en mode clair pour tout nouvel arrivant
          // Seule une sélection explicite antérieure ('dark') active le mode sombre
          if (storedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (err) {
          console.error('Erreur lors de la lecture du thème local :', err);
        }
      })();
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-[#09090b] text-slate-700 dark:text-zinc-300 antialiased selection:bg-zinc-900 selection:text-white dark:selection:bg-zinc-100 dark:selection:text-zinc-950 font-sans transition-colors duration-200">
    <!-- Sélecteur de thème flottant monochrome mat & titane (Desktop - coin supérieur droit) -->
    <aside class="fixed top-4 right-5 sm:top-5 sm:right-7 z-40 hidden lg:block" aria-label="Préférences d'affichage">
      <ThemeToggle variant="floating" />
    </aside>

    <slot />

    <!-- Inspecteur d'Architecture & Télémétrie Éco-conception (Easter Egg) -->
    <AuditInspector />
  </body>
</html>
