---
// Section 1 : Hero / Accueil
import { ArrowDownRight, FileText, Mail, MapPin, GraduationCap, Code2 } from 'lucide-astro';
import profileData from '../content/data/profile.json';

const { identity, contact, internshipSearch } = profileData;
const initials = `${identity.firstName[0] || 'Q'}${identity.lastName[0] || 'M'}`;
---

<section id="hero" class="pt-6 pb-14 lg:pt-12 lg:pb-20 scroll-mt-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    
    <!-- Colonne Gauche : Présentation claire et Call-to-Actions -->
    <div class="lg:col-span-8 space-y-6">
      
      <!-- Titre principal H1 & Sous-titre hiérarchisé -->
      <div class="space-y-3">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black font-title text-zinc-900 dark:text-zinc-100 tracking-tight leading-tight">
          {identity.firstName} <span class="text-zinc-900 dark:text-zinc-100">{identity.lastName}</span>
        </h1>
        
        <p class="text-xl sm:text-2xl font-bold text-zinc-700 dark:text-zinc-300">
          Étudiant en informatique <span class="text-zinc-400 dark:text-zinc-500 font-normal select-none">-</span> BTS SIO SLAM
        </p>

        <!-- Métadonnées clés condensées et faciles à lire -->
        <div class="flex items-center gap-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 flex-wrap pt-1">
          <span class="inline-flex items-center gap-1.5 font-medium">
            <GraduationCap class="w-4 h-4 text-zinc-700 dark:text-zinc-300 shrink-0" />
            CNED
          </span>
          <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600 shrink-0 select-none" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-1.5 font-medium">
            <MapPin class="w-4 h-4 text-zinc-700 dark:text-zinc-300 shrink-0" />
            Cambrai (59)
          </span>
          <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600 shrink-0 select-none" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-semibold">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            Stage {internshipSearch.duration} ({internshipSearch.period})
          </span>
        </div>
      </div>

      <!-- Phrase d'accroche valorisant les compétences -->
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
        {identity.tagline}
      </p>

      <!-- Groupe de boutons d'action (CTA) directs -->
      <div class="flex flex-wrap items-center gap-3.5 pt-1">
        
        <!-- CTA Primaire : Voir les projets (Noir mat absolu chic / Blanc en dark) -->
        <a
          href="#projets"
          class="inline-flex items-center gap-2 px-5 sm:px-6 py-3 rounded-xl bg-zinc-900 hover:bg-black dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-semibold text-sm shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
        >
          <span>Voir les projets</span>
          <ArrowDownRight class="w-4 h-4" />
        </a>

        <!-- CTA Secondaire : Télécharger / Voir mon CV -->
        <a
          href={identity.cvDownloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-zinc-50 dark:bg-zinc-900 dark:hover:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 font-semibold text-sm shadow-sm hover:shadow transition-all duration-200 transform hover:-translate-y-0.5 group"
        >
          <FileText class="w-4 h-4 text-zinc-700 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors" />
          <span>Voir mon CV (PDF)</span>
        </a>

        <!-- CTA Tertiaire : Me contacter -->
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-4 py-3 rounded-xl text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 font-medium text-sm transition-all duration-200"
        >
          <Mail class="w-4 h-4 text-zinc-400" />
          <span>Me contacter</span>
        </a>
      </div>

    </div>

    <!-- Colonne Droite : Visuel portrait & Carte badge épurée -->
    <div class="lg:col-span-4 flex justify-center">
      <div class="relative w-64 h-64 sm:w-72 sm:h-72">
        
        <!-- Cercle de fond décoratif feutré -->
        <div class="absolute inset-0 rounded-3xl bg-gradient-to-tr from-zinc-500/10 via-zinc-400/5 to-transparent transform -rotate-3 transition-transform hover:rotate-0 duration-300"></div>

        <!-- Conteneur d'image avec ombre douce et bordure sobre -->
        <div class="relative w-full h-full rounded-3xl overflow-hidden bg-white dark:bg-[#18181B] p-3 shadow-soft border-2 border-zinc-200 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors flex flex-col items-center justify-center">
          <div class="w-full h-full rounded-2xl overflow-hidden bg-zinc-900 flex items-center justify-center relative">
            <img
              src={identity.avatarUrl}
              alt={`${identity.firstName} ${identity.lastName}`}
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="hidden w-full h-full bg-zinc-900 flex-col items-center justify-center text-white">
              <span class="text-5xl font-bold font-title text-zinc-300">{initials}</span>
              <span class="text-xs uppercase tracking-widest mt-2 text-zinc-400 font-title">SLAM CNED</span>
            </div>
          </div>
        </div>

        <!-- Pastille flottante SLAM Développeur -->
        <div class="absolute -bottom-3 -right-3 bg-white dark:bg-zinc-900 px-3.5 py-1.5 rounded-xl shadow-lg border border-zinc-200 dark:border-zinc-700 flex items-center gap-2">
          <!-- Icône de code pour l'option développement SLAM -->
          <Code2 class="w-3.5 h-3.5 text-zinc-900 dark:text-zinc-100 shrink-0" />
          <span class="text-xs font-bold text-zinc-900 dark:text-zinc-100 font-title">Option SLAM</span>
        </div>

      </div>
    </div>

  </div>
</section>
