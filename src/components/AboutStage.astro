---
// Section 2 : Profil & Recherche de Stage 2027
import { Calendar, Clock, MapPin, CheckCircle2, ArrowRight, Target, Award, FileText } from 'lucide-astro';
import profileData from '../content/data/profile.json';
import StageRecapModal from './StageRecapModal.astro';

const { bio, internshipSearch } = profileData;
---

<section id="profil" class="py-16 scroll-mt-20 border-t border-slate-200 dark:border-zinc-800">
  <!-- En-tête de section -->
  <div class="mb-10">
    <h2 class="text-3xl font-bold font-title text-slate-900 dark:text-zinc-100 tracking-tight">
      Profil & Recherche de Stage
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    
    <!-- Colonne Gauche : Bio & Démarche d'Ingénierie alignée en hauteur -->
    <div class="lg:col-span-7 flex flex-col lg:h-full">
      <div class="bg-white dark:bg-[#18181B] p-7 sm:p-8 rounded-2xl shadow-card border border-slate-200 dark:border-[#27272A] lg:h-full flex flex-col justify-between space-y-6">
        
        <div class="space-y-4">
          <p class="text-base text-slate-800 dark:text-zinc-200 leading-relaxed font-semibold">
            {bio.intro}
          </p>
          <p class="text-sm text-slate-600 dark:text-zinc-400 leading-relaxed">
            {bio.pathway}
          </p>
          <p class="text-sm text-slate-600 dark:text-zinc-400 leading-relaxed">
            {bio.vision}
          </p>
        </div>

        <!-- Points forts et méthode -->
        <div class="pt-5 border-t border-slate-100 dark:border-zinc-800">
          <h3 class="text-xs uppercase tracking-wider text-slate-400 dark:text-zinc-500 font-bold mb-3 font-title">
            Atouts clés & Valeurs
          </h3>
          <ul class="space-y-2.5">
            {bio.strengths.map((strength) => (
              <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-zinc-300 font-medium">
                <CheckCircle2 class="w-4 h-4 text-zinc-900 dark:text-zinc-100 shrink-0 mt-0.5" />
                <span>{strength}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

    <!-- Colonne Droite : Encadré de Stage Blanc avec bandeau noir mat épuré -->
    <div class="lg:col-span-5 flex flex-col lg:h-full">
      <div class="bg-white dark:bg-[#18181B] rounded-2xl shadow-card border-2 border-zinc-200 dark:border-[#27272A] overflow-hidden relative lg:h-full flex flex-col justify-between">
        
        <!-- Bandeau supérieur noir mat chic -->
        <div class="bg-zinc-900 dark:bg-zinc-800 px-6 py-4 text-white flex items-center gap-2.5">
          <Target class="w-5 h-5 text-white shrink-0" />
          <h3 class="font-bold font-title text-base tracking-tight text-white">Recherche de stage 2027</h3>
        </div>

        <!-- Corps de la carte avec mentions contractuelles -->
        <div class="p-6 space-y-5 flex-1 flex flex-col justify-between">
          <div class="space-y-3">
            
            <div class="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <Clock class="w-4 h-4" />
              </div>
              <div>
                <span class="block text-xs text-zinc-500 dark:text-zinc-400 font-medium">Durée</span>
                <span class="font-bold text-zinc-900 dark:text-zinc-100">{internshipSearch.duration}</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <Calendar class="w-4 h-4" />
              </div>
              <div>
                <span class="block text-xs text-zinc-500 dark:text-zinc-400 font-medium">Période</span>
                <span class="font-bold text-zinc-900 dark:text-zinc-100">{internshipSearch.period}</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <Award class="w-4 h-4" />
              </div>
              <div>
                <span class="block text-xs text-zinc-500 dark:text-zinc-400 font-medium">Rôle visé</span>
                <span class="font-bold text-zinc-900 dark:text-zinc-100">{internshipSearch.title}</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <MapPin class="w-4 h-4" />
              </div>
              <div>
                <span class="block text-xs text-zinc-500 dark:text-zinc-400 font-medium">Localisation</span>
                <span class="font-semibold text-zinc-900 dark:text-zinc-100">{internshipSearch.location}</span>
              </div>
            </div>

          </div>

          <!-- Missions cibles -->
          <div class="pt-3 border-t border-zinc-100 dark:border-zinc-800">
            <span class="text-xs uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-bold block mb-2.5 font-title">
              Objectifs ciblés :
            </span>
            <ul class="text-xs text-zinc-600 dark:text-zinc-400 space-y-2">
              {internshipSearch.objectifs.map((obj) => (
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 shrink-0 mt-1.5"></span>
                  <span class="leading-relaxed">{obj}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Actions de candidature & Fiche synthèse RH -->
          <div class="space-y-2.5 pt-2">
            <!-- Bouton CTA vers le formulaire de contact -->
            <a
              href="#contact"
              class="flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-xl bg-zinc-900 hover:bg-black dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-semibold text-sm transition-all duration-200 shadow-sm hover:shadow"
            >
              <span>{internshipSearch.callToAction}</span>
              <ArrowRight class="w-4 h-4" />
            </a>

            <!-- Bouton secondaire ouvrant la fiche synthèse pour recruteurs et tuteurs -->
            <button
              type="button"
              data-open-stage-modal
              class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-white hover:bg-zinc-50 dark:bg-zinc-900 dark:hover:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-800 font-semibold text-sm transition-all duration-200 shadow-sm hover:shadow cursor-pointer"
            >
              <FileText class="w-4 h-4 text-zinc-700 dark:text-zinc-300" />
              <span>Fiche Synthèse RH & Tuteur</span>
            </button>
          </div>

        </div>

      </div>
    </div>

  </div>

  <!-- Modale Fiche Synthèse Entreprise & RH -->
  <StageRecapModal />
</section>
