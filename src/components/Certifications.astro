---
// Section 5 : Certifications & Attestations officielles
import { Award, ShieldCheck, ExternalLink } from 'lucide-astro';
import timelineData from '../content/data/timeline.json';

const { certifications } = timelineData;
const techCerts = certifications.filter((c) => c.category === 'tech');
const citizenCerts = certifications.filter((c) => c.category === 'citoyen');

// Style des badges de statut avec couleurs allégées et modernes (ambre pour en préparation, émeraude pour délivrée)
function getStatusBadgeStyle(status: string) {
  const s = status.toLowerCase();
  if (s.includes('délivr') || s.includes('obten')) {
    return {
      badgeClass: 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-500/30',
      dotClass: 'bg-emerald-500 dark:bg-emerald-400',
    };
  }
  return {
    badgeClass: 'bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-500/30',
    dotClass: 'bg-amber-500 dark:bg-amber-400',
  };
}
---

<section id="certifications" class="py-16 scroll-mt-20 border-t border-slate-200 dark:border-zinc-800">
  <!-- En-tête de section -->
  <div class="mb-12">
    <h2 class="text-3xl font-bold font-title text-slate-900 dark:text-zinc-100 tracking-tight">
      Certifications Professionnelles
    </h2>
    <p class="text-sm text-slate-600 dark:text-zinc-400 mt-2 max-w-2xl">
      Certifications techniques préparées dans le cadre du BTS SIO et attestations officielles obtenues lors de mon engagement citoyen.
    </p>
  </div>

  <div class="space-y-12">
    
    <!-- Groupe 1 : Informatique & Cybersécurité (BTS SIO) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between pb-1">
        <h3 class="text-base font-bold font-title text-slate-900 dark:text-zinc-100 flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0">
            <ShieldCheck class="w-4 h-4" />
          </span>
          <span>Informatique & Cybersécurité (BTS SIO)</span>
        </h3>
        <span class="text-xs font-semibold text-slate-500 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800/80 px-2.5 py-1 rounded-full border border-slate-200 dark:border-zinc-700">
          {techCerts.length} certifications
        </span>
      </div>

      <div class="space-y-4">
        {techCerts.map((cert) => {
          const statusStyle = getStatusBadgeStyle(cert.status);
          return (
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-5 group">
              
              <!-- Contenu Gauche : Logo + Infos -->
              <div class="flex items-start sm:items-center gap-4 flex-1">
                <!-- Logo vectoriel épuré de l'organisme -->
                <div class="w-14 h-14 rounded-2xl bg-slate-50 dark:bg-zinc-900 p-3 shrink-0 flex items-center justify-center border border-slate-200 dark:border-zinc-800 shadow-sm group-hover:scale-105 group-hover:border-zinc-400 dark:group-hover:border-zinc-600 transition-all">
                  <img
                    src={`/assets/badges/${cert.badge}`}
                    alt={cert.issuer}
                    class="w-full h-full object-contain"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden w-full h-full text-zinc-900 dark:text-zinc-100 items-center justify-center">
                    <Award class="w-7 h-7" />
                  </div>
                </div>

                <!-- Métadonnées & Intitulé épurés -->
                <div class="space-y-1">
                  <h3 class="text-base sm:text-lg font-bold font-title text-slate-900 dark:text-zinc-100 group-hover:text-zinc-900 dark:group-hover:text-white transition-colors">
                    {cert.title}
                  </h3>
                  <p class="text-xs font-semibold text-slate-500 dark:text-zinc-400 flex items-center gap-2">
                    <span class="text-zinc-900 dark:text-zinc-200 font-semibold">{cert.issuer}</span>
                    <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600 shrink-0 select-none" aria-hidden="true"></span>
                    <span>{cert.date}</span>
                  </p>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed max-w-2xl pt-1">
                    {cert.summary}
                  </p>
                </div>
              </div>

              <!-- Contenu Droite : Statut Sobre & Lien Vérification -->
              <div class="flex items-center gap-3 shrink-0 self-end md:self-center w-full md:w-auto justify-between md:justify-end">
                <span class={`inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg border ${statusStyle.badgeClass}`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${statusStyle.dotClass}`}></span>
                  <span>{cert.status}</span>
                </span>

                {cert.credentialUrl && (
                  <a
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xl text-slate-400 hover:text-zinc-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors"
                    title="Consulter la plateforme officielle"
                  >
                    <ExternalLink class="w-4 h-4" />
                  </a>
                )}
              </div>

            </div>
          );
        })}
      </div>
    </div>

    <!-- Groupe 2 : Attestations & Habilitations Citoyennes (Service Civique) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between pb-1">
        <h3 class="text-base font-bold font-title text-slate-900 dark:text-zinc-100 flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0">
            <Award class="w-4 h-4" />
          </span>
          <span>Attestations & Habilitations Citoyennes (Service Civique)</span>
        </h3>
        <span class="text-xs font-semibold text-slate-500 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800/80 px-2.5 py-1 rounded-full border border-slate-200 dark:border-zinc-700">
          {citizenCerts.length} attestations
        </span>
      </div>

      <div class="space-y-4">
        {citizenCerts.map((cert) => {
          const statusStyle = getStatusBadgeStyle(cert.status);
          return (
            <div class="bg-white dark:bg-[#18181B] rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-5 group">
              
              <!-- Contenu Gauche : Logo + Infos -->
              <div class="flex items-start sm:items-center gap-4 flex-1">
                <!-- Logo vectoriel épuré de l'organisme -->
                <div class="w-14 h-14 rounded-2xl bg-slate-50 dark:bg-zinc-900 p-3 shrink-0 flex items-center justify-center border border-slate-200 dark:border-zinc-800 shadow-sm group-hover:scale-105 group-hover:border-zinc-400 dark:group-hover:border-zinc-600 transition-all">
                  <img
                    src={`/assets/badges/${cert.badge}`}
                    alt={cert.issuer}
                    class="w-full h-full object-contain"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden w-full h-full text-zinc-900 dark:text-zinc-100 items-center justify-center">
                    <Award class="w-7 h-7" />
                  </div>
                </div>

                <!-- Métadonnées & Intitulé épurés -->
                <div class="space-y-1">
                  <h3 class="text-base sm:text-lg font-bold font-title text-slate-900 dark:text-zinc-100 group-hover:text-zinc-900 dark:group-hover:text-white transition-colors">
                    {cert.title}
                  </h3>
                  <p class="text-xs font-semibold text-slate-500 dark:text-zinc-400 flex items-center gap-2">
                    <span class="text-zinc-900 dark:text-zinc-200 font-semibold">{cert.issuer}</span>
                    <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600 shrink-0 select-none" aria-hidden="true"></span>
                    <span>{cert.date}</span>
                  </p>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed max-w-2xl pt-1">
                    {cert.summary}
                  </p>
                </div>
              </div>

              <!-- Contenu Droite : Statut Sobre -->
              <div class="flex items-center gap-3 shrink-0 self-end md:self-center w-full md:w-auto justify-between md:justify-end">
                <span class={`inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg border ${statusStyle.badgeClass}`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${statusStyle.dotClass}`}></span>
                  <span>{cert.status}</span>
                </span>
              </div>

            </div>
          );
        })}
      </div>
    </div>

  </div>
</section>
