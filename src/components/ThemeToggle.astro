---
// Composant réutilisable de bascule de thème (Clair / Sombre)
// Conforme au design monochrome mat et titane du portfolio
import { Sun, Moon } from 'lucide-astro';

interface Props {
  // 'compact' pour la navbar mobile, 'floating' pour le coin supérieur droit desktop
  variant?: 'compact' | 'floating';
  className?: string;
}

const { variant = 'floating', className = '' } = Astro.props;
---

{variant === 'compact' ? (
  <button
    type="button"
    class={`theme-toggle-btn p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-600 cursor-pointer ${className}`}
    aria-label="Basculer entre le mode clair et le mode sombre"
    title="Changer de thème"
  >
    <!-- Icône Soleil (affichée en mode sombre pour repasser en clair) -->
    <span class="dark:inline hidden">
      <Sun class="w-5 h-5 text-zinc-300 hover:text-white transition-colors" />
    </span>
    <!-- Icône Lune (affichée en mode clair pour passer en sombre) -->
    <span class="dark:hidden inline">
      <Moon class="w-5 h-5 text-zinc-400 hover:text-white transition-colors" />
    </span>
  </button>
) : (
  <button
    type="button"
    class={`theme-toggle-btn group inline-flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white/90 dark:bg-[#18181B]/90 hover:bg-white dark:hover:bg-[#18181B] backdrop-blur-md text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white text-xs font-semibold border border-zinc-200/90 dark:border-[#27272A] hover:border-zinc-300 dark:hover:border-zinc-700 shadow-card hover:shadow-card-hover transition-all duration-200 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-zinc-900/20 dark:focus:ring-zinc-100/20 cursor-pointer ${className}`}
    aria-label="Basculer entre le mode clair et le mode sombre"
    title="Changer de thème"
  >
    <!-- Icône Soleil en mode sombre -->
    <span class="dark:inline hidden">
      <Sun class="w-4 h-4 text-zinc-200 group-hover:text-white shrink-0 transition-colors" />
    </span>
    <!-- Icône Lune en mode clair -->
    <span class="dark:hidden inline">
      <Moon class="w-4 h-4 text-zinc-600 group-hover:text-zinc-950 shrink-0 transition-colors" />
    </span>
    
    <!-- Texte descriptif selon le mode actif -->
    <span class="font-title tracking-tight">
      <span class="dark:hidden inline">Mode clair</span>
      <span class="dark:inline hidden">Mode sombre</span>
    </span>
  </button>
)}

<script>
  // Fonction de bascule et persistance du thème
  function toggleTheme() {
    try {
      const isCurrentlyDark = document.documentElement.classList.contains('dark');
      const targetTheme = isCurrentlyDark ? 'light' : 'dark';

      if (targetTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      localStorage.setItem('portfolio-theme', targetTheme);
    } catch (storageError) {
      console.error('Erreur lors de la sauvegarde du thème utilisateur dans le localStorage :', storageError);
    }
  }

  // Écouteur d'événement délégué sur l'ensemble du document (résistant aux re-rendus et navigations)
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('.theme-toggle-btn');
    if (button) {
      toggleTheme();
    }
  });
</script>
