---
// Section 7 : Veille Technologique & Réglementaire (Format épuré avec navigation latérale centrée)
import {
  ShieldCheck,
  Cpu,
  Radio,
  Rss,
  Bell,
  ExternalLink,
  ArrowUpRight,
  BookOpen,
  X,
  Clock,
  ChevronLeft,
  ChevronRight,
} from 'lucide-astro';
import fs from 'node:fs';
import path from 'node:path';
import veilleData from '../content/data/veille.json';

const { title, subtitle, pearltreesUrl, axes } = veilleData;

// Correspondance des icônes pour les en-têtes d'axes
const axisIconMap: Record<string, any> = {
  cybersecurite: ShieldCheck,
  'ia-ingenierie': Cpu,
};

// Chargement sécurisé des véritables logos vectoriels colorés des sources
const sourceLogoMap: Record<string, string> = {};
const sourceFiles: Record<string, string> = {
  anssi: 'source-anssi.svg',
  owasp: 'source-owasp.svg',
  github: 'source-github.svg',
  'solutions-numeriques': 'source-solutions-numeriques.svg',
  lemagit: 'source-lemagit.svg',
};

for (const [key, filename] of Object.entries(sourceFiles)) {
  try {
    const fullPath = path.join(process.cwd(), 'public', 'assets', 'icons', 'sources', filename);
    if (fs.existsSync(fullPath)) {
      let svg = fs.readFileSync(fullPath, 'utf-8');
      svg = svg.replace(/<\?xml[^>]*\?>/gi, '').replace(/<!--[\s\S]*?-->/g, '').trim();
      sourceLogoMap[key] = svg;
    }
  } catch {
    // Repli propre silencieux
  }
}

// Calcul du total des fiches de veille
const totalArticles = axes.reduce((acc, axis) => acc + axis.articles.length, 0);
---

<section id="veille" class="py-16 scroll-mt-20 border-t border-slate-200 dark:border-zinc-800">
  <!-- En-tête de section sobre -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
    <div>
      <h2 class="text-3xl font-bold font-title text-slate-900 dark:text-zinc-100 tracking-tight">
        {title}
      </h2>
      <p class="text-sm text-slate-600 dark:text-zinc-400 mt-2 max-w-2xl leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Accès direct à l'espace complet Pearltrees -->
    <a
      href={pearltreesUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-zinc-900 hover:bg-slate-50 dark:hover:bg-zinc-800 text-slate-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white border border-slate-200 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500 text-xs font-semibold shadow-card transition-all shrink-0 group self-start sm:self-auto"
    >
      <span>Espace Pearltrees</span>
      <ExternalLink class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors" />
    </a>
  </div>

  <!-- Encadré compact de méthodologie Push & Pull (Design épuré et lisible) -->
  <div class="bg-white dark:bg-[#18181B] rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-[#27272A] shadow-card mb-8 flex flex-col md:flex-row md:items-center justify-between gap-5">
    <div class="flex items-start sm:items-center gap-4">
      <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 flex items-center justify-center shrink-0 border border-zinc-200 dark:border-zinc-700">
        <Radio class="w-5 h-5" />
      </div>
      <div>
        <h3 class="text-sm font-bold font-title text-slate-900 dark:text-zinc-100">
          Dispositif méthodologique bimodal (Push & Pull)
        </h3>
        <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">
          Combinaison d'alertes automatisées et d'agrégation ciblée pour capter les standards émergents.
        </p>
      </div>
    </div>

    <!-- Puces rapides des outils utilisés -->
    <div class="flex flex-wrap items-center gap-2.5 text-xs">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 border border-slate-200 dark:border-zinc-700 font-medium">
        <Bell class="w-3.5 h-3.5 text-zinc-900 dark:text-zinc-100" />
        <span><strong>Push :</strong> Google Alerts & Newsletters</span>
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 border border-slate-200 dark:border-zinc-700 font-medium">
        <Rss class="w-3.5 h-3.5 text-zinc-700 dark:text-zinc-300" />
        <span><strong>Pull :</strong> Flux RSS Feedly & Avis ANSSI</span>
      </span>
    </div>
  </div>

  <!-- Système de rangement / filtrage interactif par axe (Sobre et épuré) -->
  <div class="flex items-center mb-8">
    <div class="inline-flex items-center p-1 rounded-2xl bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 text-xs">
      <button
        type="button"
        class="veille-filter-btn px-4 py-2 rounded-xl font-semibold transition-all cursor-pointer bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 shadow-sm"
        data-filter="all"
      >
        Toutes les fiches ({totalArticles})
      </button>
      {axes.map((axis) => (
        <button
          type="button"
          class="veille-filter-btn px-4 py-2 rounded-xl font-medium text-slate-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all cursor-pointer"
          data-filter={axis.id}
        >
          {axis.name} ({axis.articles.length})
        </button>
      ))}
    </div>
  </div>

  <!-- Présentation structurée par catégories (Axes filtrables) -->
  <div class="space-y-12">
    {axes.map((axis) => {
      const AxisIcon = axisIconMap[axis.id] || Radio;
      return (
        <div class="veille-axis-block space-y-4" data-axis-id={axis.id}>
          <!-- Titre d'axe avec icône et compteur -->
          <div class="flex items-center justify-between pb-1">
            <h3 class="text-base font-bold font-title text-slate-900 dark:text-zinc-100 flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0">
                <AxisIcon class="w-4 h-4" />
              </span>
              <span>{axis.name}</span>
            </h3>
            <span class="text-xs font-semibold text-slate-500 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800 px-2.5 py-1 rounded-full border border-slate-200 dark:border-zinc-700">
              {axis.articles.length} fiches
            </span>
          </div>

          <!-- Grille uniforme et aérée de cartes exécutives -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
            {axis.articles.map((article) => {
              const svgLogo = sourceLogoMap[article.sourceId] || '';
              return (
                <button
                  type="button"
                  class="veille-card text-left bg-white dark:bg-[#18181B] rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:border-zinc-400 dark:hover:border-zinc-500 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between group cursor-pointer w-full focus:outline-none focus:ring-2 focus:ring-zinc-900/40 min-h-[175px]"
                  data-title={article.title}
                  data-source={article.source}
                  data-sourcetype={article.sourceType}
                  data-date={article.date}
                  data-readtime={article.readTime}
                  data-summary={article.summary}
                  data-url={article.url}
                  data-keypoints={JSON.stringify(article.keyPoints)}
                  data-tags={JSON.stringify(article.tags)}
                  data-axis={axis.name}
                >
                  <div class="space-y-3.5">
                    <!-- En-tête : Logo officiel net + Nom complet de la source et Date (empilés proprement, zéro coupure) -->
                    <div class="flex items-center gap-3">
                      <!-- Vrai logo coloré officiel de la source (sans contour parasite) -->
                      <div class="veille-card-logo w-8 h-8 rounded-lg overflow-hidden shrink-0 flex items-center justify-center shadow-2xs">
                        <div class="w-full h-full flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={svgLogo} />
                      </div>

                      <!-- Nom complet de la source + Date sur 2 lignes pour garantir 100% de lisibilité -->
                      <div class="min-w-0 flex-1">
                        <span class="text-xs font-bold text-slate-900 dark:text-zinc-200 block leading-tight">
                          {article.source}
                        </span>
                        <span class="text-[11px] font-medium text-slate-400 dark:text-zinc-500 block mt-0.5">
                          {article.date}
                        </span>
                      </div>
                    </div>

                    <!-- Titre complet de l'article (100% lisible, sans aucune troncature) -->
                    <h4 class="text-sm sm:text-[14.5px] font-bold font-title text-slate-900 dark:text-zinc-100 group-hover:text-black dark:group-hover:text-white transition-colors leading-snug">
                      {article.title}
                    </h4>
                  </div>

                  <!-- Bas de carte : Temps de lecture + Action consultative -->
                  <div class="pt-3.5 border-t border-slate-100 dark:border-zinc-800 mt-5 flex items-center justify-between text-xs">
                    <span class="text-[11px] font-medium text-slate-400 dark:text-zinc-500 flex items-center gap-1.5">
                      <Clock class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500" />
                      <span>{article.readTime}</span>
                    </span>

                    <div class="inline-flex items-center gap-1 font-semibold text-zinc-900 dark:text-zinc-300 group-hover:text-black dark:group-hover:text-white transition-colors">
                      <span>Consulter la fiche</span>
                      <ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                    </div>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Fenêtre modale descriptive détaillée (Format Dossier Exécutif avec navigation latérale centrée) -->
  <div
    id="veille-modal-backdrop"
    class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4 sm:p-6"
    aria-hidden="true"
  >
    <!-- Conteneur relatif pour positionner les flèches flottantes dans le vide de chaque côté -->
    <div class="relative w-full max-w-2xl flex items-center justify-center pointer-events-none">

      <!-- Flèche flottante Gauche (centrée verticalement dans le vide à gauche) -->
      <button
        id="veille-modal-prev-float"
        type="button"
        aria-label="Fiche précédente"
        title="Fiche précédente (Flèche gauche)"
        class="hidden sm:flex pointer-events-auto absolute -left-14 md:-left-20 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white dark:bg-[#18181B] text-zinc-800 dark:text-zinc-200 hover:text-black dark:hover:text-white hover:bg-white dark:hover:bg-zinc-800 border border-slate-200/90 dark:border-[#27272A] shadow-xl hover:shadow-2xl hover:scale-110 active:scale-95 transition-all duration-200 items-center justify-center cursor-pointer z-50 disabled:opacity-0 disabled:pointer-events-none group"
      >
        <ChevronLeft class="w-6 h-6 transition-transform group-hover:-translate-x-0.5" />
      </button>

      <!-- Carte principale de la modale -->
      <div
        id="veille-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="veille-modal-title"
        class="pointer-events-auto bg-white dark:bg-[#18181B] rounded-3xl p-6 sm:p-8 w-full shadow-2xl border border-slate-200 dark:border-[#27272A] transform scale-95 transition-all duration-200 relative text-left max-h-[88vh] overflow-y-auto"
      >
        <!-- En-tête épuré : Source + Identité à gauche, Compteur + Croix à droite -->
        <div class="flex items-center justify-between gap-4 pb-4 mb-4 border-b border-slate-100 dark:border-zinc-800">
          <!-- En-tête source : Logo + Nom + Axe + Date -->
          <div class="flex items-center gap-3 min-w-0">
            <div
              id="veille-modal-logo"
              class="w-10 h-10 rounded-xl overflow-hidden shrink-0 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full shadow-2xs"
            ></div>

            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span id="veille-modal-source" class="text-sm font-bold text-slate-900 dark:text-zinc-100 leading-tight"></span>
                <span id="veille-modal-axis" class="text-[11px] font-semibold text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded-md border border-zinc-200 dark:border-zinc-700"></span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-zinc-400 mt-1 flex-wrap">
                <span id="veille-modal-date" class="font-medium text-slate-600 dark:text-zinc-300"></span>
                <span class="text-slate-300 dark:text-zinc-600">•</span>
                <span id="veille-modal-sourcetype" class="text-slate-500 dark:text-zinc-400 font-medium"></span>
              </div>
            </div>
          </div>

          <!-- Indicateur d'avancement discret + Bouton de fermeture -->
          <div class="flex items-center gap-2.5 shrink-0">
            <span
              id="veille-modal-counter"
              class="text-xs font-semibold text-slate-500 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800 px-3 py-1 rounded-full border border-slate-200 dark:border-zinc-700 select-none whitespace-nowrap"
            >
              1 / 6
            </span>

            <button
              id="veille-modal-close"
              type="button"
              aria-label="Fermer la fiche"
              title="Fermer (Échap)"
              class="p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-zinc-200 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none cursor-pointer"
            >
              <X class="w-5 h-5" />
            </button>
          </div>
        </div>

        <!-- Titre complet de l'article -->
        <h3 id="veille-modal-title" class="text-xl sm:text-2xl font-bold font-title text-slate-900 dark:text-zinc-100 tracking-tight leading-snug mb-4"></h3>

        <!-- Bandeau de métriques de qualification (3 badges équilibrés) -->
        <div class="flex flex-wrap items-center gap-2 mb-6 pb-4 border-b border-slate-100 dark:border-zinc-800">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 border border-slate-200/80 dark:border-zinc-800 text-xs font-medium">
            <Clock class="w-3.5 h-3.5 text-slate-500 dark:text-zinc-400" />
            <span id="veille-modal-readtime"></span>
          </span>

          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 border border-slate-200/80 dark:border-zinc-800 text-xs font-medium">
            <ShieldCheck class="w-3.5 h-3.5 text-zinc-900 dark:text-zinc-100" />
            <span>Épreuve E4 (Option SLAM)</span>
          </span>

          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 border border-slate-200/80 dark:border-zinc-800 text-xs font-medium">
            <BookOpen class="w-3.5 h-3.5 text-slate-500 dark:text-zinc-400" />
            <span>Source certifiée</span>
          </span>
        </div>

        <!-- Section 1 : Résumé analytique dans un encadré teinté et soigné -->
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-2.5">
            <div class="w-1.5 h-4 bg-zinc-900 dark:bg-zinc-100 rounded-full"></div>
            <h4 class="text-xs uppercase tracking-wider font-bold text-slate-500 dark:text-zinc-400 font-title">
              Résumé analytique
            </h4>
          </div>
          <div class="bg-slate-50/80 dark:bg-zinc-900/80 rounded-2xl p-4 sm:p-5 border border-slate-200/70 dark:border-zinc-800">
            <p id="veille-modal-summary" class="text-xs sm:text-sm text-slate-700 dark:text-zinc-300 leading-relaxed"></p>
          </div>
        </div>

        <!-- Section 2 : Enjeux & Retombées techniques (Présentation unifiée et aérée) -->
        <div class="mb-6">
          <div class="flex items-center justify-between mb-2.5">
            <div class="flex items-center gap-2">
              <div class="w-1.5 h-4 bg-zinc-900 dark:bg-zinc-100 rounded-full"></div>
              <h4 class="text-xs uppercase tracking-wider font-bold text-slate-500 dark:text-zinc-400 font-title">
                Enjeux & Retombées techniques (BTS SIO SLAM)
              </h4>
            </div>
            <span class="text-[11px] font-semibold text-slate-500 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded-md border border-slate-200 dark:border-zinc-700">
              3 points clés
            </span>
          </div>
          <div class="bg-slate-50/80 dark:bg-zinc-900/80 rounded-2xl p-4 sm:p-5 border border-slate-200/70 dark:border-zinc-800">
            <ul id="veille-modal-keypoints" class="space-y-3"></ul>
          </div>
        </div>

        <!-- Section 3 : Mots-clés & Normes associés (Tags) -->
        <div class="mb-6">
          <h4 class="text-xs uppercase tracking-wider font-bold text-slate-400 dark:text-zinc-400 font-title mb-2">
            Mots-clés & Normes associés
          </h4>
          <div id="veille-modal-tags" class="flex flex-wrap items-center gap-1.5"></div>
        </div>

        <!-- Actions de pied de modale : Fermer + Bouton source officielle (et navigation mobile compacte) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-slate-100 dark:border-zinc-800">
          <div class="flex items-center gap-2">
            <!-- Bouton Fermer sur desktop -->
            <button
              id="veille-modal-close-footer"
              type="button"
              class="px-4 py-2.5 rounded-xl bg-white dark:bg-zinc-800 hover:bg-slate-50 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 border border-slate-200 dark:border-zinc-700 text-xs font-semibold transition-colors cursor-pointer"
            >
              Fermer
            </button>

            <!-- Navigation mobile compacte (visible uniquement sur petit écran) -->
            <div class="sm:hidden flex items-center gap-1.5">
              <button
                id="veille-modal-prev-mobile"
                type="button"
                aria-label="Fiche précédente"
                class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-zinc-800 hover:bg-slate-200 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 text-xs font-semibold disabled:opacity-30 disabled:pointer-events-none"
              >
                ←
              </button>
              <button
                id="veille-modal-next-mobile"
                type="button"
                aria-label="Fiche suivante"
                class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-zinc-800 hover:bg-slate-200 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 text-xs font-semibold disabled:opacity-30 disabled:pointer-events-none"
              >
                →
              </button>
            </div>
          </div>

          <!-- Bouton d'action vers la source originale -->
          <a
            id="veille-modal-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-black dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-semibold text-xs transition-colors shadow-sm cursor-pointer"
          >
            <span>Consulter la source officielle</span>
            <ExternalLink class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Flèche flottante Droite (centrée verticalement dans le vide à droite) -->
      <button
        id="veille-modal-next-float"
        type="button"
        aria-label="Fiche suivante"
        title="Fiche suivante (Flèche droite)"
        class="hidden sm:flex pointer-events-auto absolute -right-14 md:-right-20 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white dark:bg-[#18181B] text-zinc-800 dark:text-zinc-200 hover:text-black dark:hover:text-white hover:bg-white dark:hover:bg-zinc-800 border border-slate-200/90 dark:border-[#27272A] shadow-xl hover:shadow-2xl hover:scale-110 active:scale-95 transition-all duration-200 items-center justify-center cursor-pointer z-50 disabled:opacity-0 disabled:pointer-events-none group"
      >
        <ChevronRight class="w-6 h-6 transition-transform group-hover:translate-x-0.5" />
      </button>

    </div>
  </div>
</section>

<!-- Script interactif de filtrage d'axes, d'ouverture et de navigation séquentielle de la modale -->
<script>
  // Gestion des filtres interactifs par axe
  const filterBtns = document.querySelectorAll('.veille-filter-btn');
  const axisBlocks = document.querySelectorAll('.veille-axis-block');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Mise à jour de l'apparence des onglets
      filterBtns.forEach((b) => {
        b.classList.remove('bg-zinc-900', 'text-white', 'shadow-sm', 'font-semibold');
        b.classList.add('text-slate-600', 'font-medium');
      });
      btn.classList.add('bg-zinc-900', 'text-white', 'shadow-sm', 'font-semibold');
      btn.classList.remove('text-slate-600', 'font-medium');

      // Affichage ou masquage des blocs d'axes
      axisBlocks.forEach((block) => {
        const axisId = block.getAttribute('data-axis-id');
        if (filter === 'all' || filter === axisId) {
          (block as HTMLElement).style.display = 'block';
        } else {
          (block as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Gestion de la modale descriptive des fiches de veille avec navigation Suivant / Précédent
  const allCards = Array.from(document.querySelectorAll('.veille-card')) as HTMLElement[];
  const backdrop = document.getElementById('veille-modal-backdrop');
  const modalCard = document.getElementById('veille-modal-card');
  const closeBtn = document.getElementById('veille-modal-close');
  const closeFooterBtn = document.getElementById('veille-modal-close-footer');

  // Boutons flottants latéraux au centre de l'écran
  const prevBtnFloat = document.getElementById('veille-modal-prev-float') as HTMLButtonElement | null;
  const nextBtnFloat = document.getElementById('veille-modal-next-float') as HTMLButtonElement | null;

  // Boutons mobiles compacts de secours
  const prevBtnMobile = document.getElementById('veille-modal-prev-mobile') as HTMLButtonElement | null;
  const nextBtnMobile = document.getElementById('veille-modal-next-mobile') as HTMLButtonElement | null;

  const modalCounter = document.getElementById('veille-modal-counter');
  const modalTitle = document.getElementById('veille-modal-title');
  const modalAxis = document.getElementById('veille-modal-axis');
  const modalDate = document.getElementById('veille-modal-date');
  const modalSource = document.getElementById('veille-modal-source');
  const modalSourceType = document.getElementById('veille-modal-sourcetype');
  const modalReadTime = document.getElementById('veille-modal-readtime');
  const modalSummary = document.getElementById('veille-modal-summary');
  const modalKeyPoints = document.getElementById('veille-modal-keypoints');
  const modalTags = document.getElementById('veille-modal-tags');
  const modalLogo = document.getElementById('veille-modal-logo');
  const modalLink = document.getElementById('veille-modal-link') as HTMLAnchorElement;

  let currentCardIndex = 0;

  // Récupère uniquement les cartes actuellement visibles selon le filtre actif
  function getVisibleCards(): HTMLElement[] {
    return allCards.filter((card) => {
      const parentBlock = card.closest('.veille-axis-block') as HTMLElement;
      return !parentBlock || parentBlock.style.display !== 'none';
    });
  }

  // Met à jour l'état des boutons de navigation et le compteur
  function updateNavigationControls() {
    const visibleCards = getVisibleCards();
    const total = visibleCards.length;
    const current = currentCardIndex + 1;

    if (modalCounter) {
      modalCounter.textContent = `${current} / ${total}`;
    }

    const isFirst = currentCardIndex <= 0;
    const isLast = currentCardIndex >= total - 1;

    if (prevBtnFloat) prevBtnFloat.disabled = isFirst;
    if (nextBtnFloat) nextBtnFloat.disabled = isLast;
    if (prevBtnMobile) prevBtnMobile.disabled = isFirst;
    if (nextBtnMobile) nextBtnMobile.disabled = isLast;
  }

  function renderCardData(card: HTMLElement) {
    const title = card.getAttribute('data-title') || '';
    const axis = card.getAttribute('data-axis') || '';
    const date = card.getAttribute('data-date') || '';
    const source = card.getAttribute('data-source') || '';
    const sourceType = card.getAttribute('data-sourcetype') || '';
    const readTime = card.getAttribute('data-readtime') || '';
    const summary = card.getAttribute('data-summary') || '';
    const url = card.getAttribute('data-url') || '#';
    const keypointsRaw = card.getAttribute('data-keypoints') || '[]';
    const tagsRaw = card.getAttribute('data-tags') || '[]';

    if (modalTitle) modalTitle.textContent = title;
    if (modalAxis) modalAxis.textContent = axis;
    if (modalDate) modalDate.textContent = date;
    if (modalSource) modalSource.textContent = source;
    if (modalSourceType) modalSourceType.textContent = sourceType;
    if (modalReadTime) modalReadTime.textContent = `${readTime} de lecture`;
    if (modalSummary) modalSummary.textContent = summary;
    if (modalLink) modalLink.href = url;

    // Duplication propre du logo officiel
    if (modalLogo) {
      const cardLogo = card.querySelector('.veille-card-logo')?.innerHTML;
      if (cardLogo) {
        modalLogo.innerHTML = cardLogo;
      }
    }

    // Remplissage harmonisé des 3 retombées techniques dans le conteneur unifié
    if (modalKeyPoints) {
      modalKeyPoints.innerHTML = '';
      try {
        const points: string[] = JSON.parse(keypointsRaw);
        points.forEach((point, index) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-3 pb-3 border-b border-slate-200/60 last:border-0 last:pb-0';
          li.innerHTML = `
            <span class="w-5 h-5 rounded-md bg-white border border-slate-200/90 text-zinc-900 flex items-center justify-center shrink-0 mt-0.5 text-[11px] font-bold shadow-2xs">
              ${index + 1}
            </span>
            <span class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">${point}</span>
          `;
          modalKeyPoints.appendChild(li);
        });
      } catch {
        // Repli en cas d'erreur
      }
    }

    // Remplissage des 3 tags thématiques
    if (modalTags) {
      modalTags.innerHTML = '';
      try {
        const tags: string[] = JSON.parse(tagsRaw);
        tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'text-[11px] font-semibold text-zinc-700 bg-zinc-100 px-2.5 py-1 rounded-lg border border-zinc-200';
          span.textContent = `#${tag}`;
          modalTags.appendChild(span);
        });
      } catch {
        // Repli en cas d'erreur
      }
    }

    updateNavigationControls();
  }

  function openModal(card: HTMLElement, isInitialOpen = true) {
    if (!backdrop || !modalCard) return;

    const visibleCards = getVisibleCards();
    const foundIndex = visibleCards.indexOf(card);
    if (foundIndex !== -1) {
      currentCardIndex = foundIndex;
    }

    renderCardData(card);

    if (isInitialOpen) {
      backdrop.classList.remove('hidden');
      setTimeout(() => {
        backdrop.classList.add('opacity-100');
        modalCard.classList.remove('scale-95');
        modalCard.classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    }
  }

  function navigateTo(offset: number) {
    const visibleCards = getVisibleCards();
    const nextIndex = currentCardIndex + offset;

    if (nextIndex >= 0 && nextIndex < visibleCards.length) {
      currentCardIndex = nextIndex;
      renderCardData(visibleCards[currentCardIndex]);
      // Remonte le scroll en haut de modale pour une lecture fluide
      if (modalCard) modalCard.scrollTop = 0;
    }
  }

  function closeModal() {
    if (!backdrop || !modalCard) return;

    backdrop.classList.remove('opacity-100');
    modalCard.classList.remove('scale-100');
    modalCard.classList.add('scale-95');

    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 200);

    document.body.style.overflow = '';
  }

  // Écouteurs de clic sur les cartes
  allCards.forEach((card) => {
    card.addEventListener('click', () => openModal(card, true));
  });

  // Écouteurs de navigation sur les flèches flottantes latérales
  if (prevBtnFloat) prevBtnFloat.addEventListener('click', () => navigateTo(-1));
  if (nextBtnFloat) nextBtnFloat.addEventListener('click', () => navigateTo(1));

  // Écouteurs mobiles de secours
  if (prevBtnMobile) prevBtnMobile.addEventListener('click', () => navigateTo(-1));
  if (nextBtnMobile) nextBtnMobile.addEventListener('click', () => navigateTo(1));

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (closeFooterBtn) closeFooterBtn.addEventListener('click', closeModal);

  if (backdrop) {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });
  }

  // Navigation au clavier
  window.addEventListener('keydown', (e) => {
    if (!backdrop || backdrop.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeModal();
    } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      navigateTo(1);
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      navigateTo(-1);
    }
  });
</script>
