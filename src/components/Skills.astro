---
// Section 4 : Compétences Techniques (Grid Cards catégorisées avec navigation fluide intégrée)
import {
  Terminal,
  Code2,
  FileCode,
  Globe,
  Palette,
  Cpu,
  GitBranch,
  Github,
  AppWindow,
  TerminalSquare,
  Container,
  Workflow,
  Database,
  Layers,
  Kanban,
  Wrench,
  Sparkles,
  Bot,
  HardDrive,
  Table2,
  Network,
  Rocket,
  ClipboardCheck,
  ShieldCheck,
  X,
  ChevronLeft,
  ChevronRight,
} from 'lucide-astro';
import fs from 'node:fs';
import path from 'node:path';
import skillsData from '../content/data/skills.json';

const { categories, items } = skillsData;

// Pré-chargement sécurisé des SVGs personnalisés pour injection directe dans le HTML
const customSvgMap: Record<string, string> = {};
for (const item of items) {
  if (item.customIcon) {
    try {
      const cleanPath = item.customIcon.startsWith('/') ? item.customIcon.slice(1) : item.customIcon;
      const fullPath = path.join(process.cwd(), 'public', cleanPath);
      if (fs.existsSync(fullPath)) {
        let svg = fs.readFileSync(fullPath, 'utf-8');
        // Nettoyage des prologues XML pour compatibilité HTML5 directe
        svg = svg.replace(/<\?xml[^>]*\?>/gi, '').replace(/<!--[\s\S]*?-->/g, '').trim();
        customSvgMap[item.customIcon] = svg;
      }
    } catch {
      // Repli propre silencieux
    }
  }
}

// Correspondance des icônes Lucide de repli
const lucideMap: Record<string, any> = {
  Terminal,
  Code2,
  FileCode,
  Globe,
  Palette,
  Cpu,
  GitBranch,
  Github,
  AppWindow,
  TerminalSquare,
  Container,
  Workflow,
  Database,
  Layers,
  Kanban,
  Sparkles,
  Bot,
  HardDrive,
  Table2,
  Network,
  Rocket,
  ClipboardCheck,
  ShieldCheck,
};

// Correspondance des icônes pour les en-têtes de catégories
const categoryIconMap: Record<string, any> = {
  'dev-ia': Code2,
  'bases-de-donnees': Database,
  'outils-environnements': Wrench,
  'methodes-gestion': Kanban,
};
---

<section id="competences" class="py-16 scroll-mt-20 border-t border-slate-200 dark:border-zinc-800">
  <!-- En-tête de section -->
  <div class="mb-12">
    <h2 class="text-3xl font-bold font-title text-slate-900 dark:text-zinc-100 tracking-tight">
      Compétences & Technologies
    </h2>
    <p class="text-sm text-slate-600 dark:text-zinc-400 mt-2 max-w-2xl">
      Technologies, outils d'ingénierie logicielle et méthodologies de gestion de projet mobilisés au quotidien. Cliquez sur une carte pour en découvrir la description.
    </p>
  </div>

  <!-- Catégories de compétences équilibrées en 4 blocs -->
  <div class="space-y-12">
    {categories.map((cat) => {
      const categorySkills = items.filter((item) => item.category === cat.id);
      const CatIcon = categoryIconMap[cat.id] || Terminal;
      return (
        <div class="space-y-4">
          <!-- Titre de catégorie avec icône thématique et compteur -->
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold font-title text-slate-900 dark:text-zinc-100 flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0">
                <CatIcon class="w-4 h-4" />
              </span>
              <span>{cat.title}</span>
            </h3>
            <span class="text-xs font-semibold text-slate-500 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800/80 px-2.5 py-1 rounded-full border border-slate-200 dark:border-zinc-700">
              {categorySkills.length} technologies
            </span>
          </div>

          <!-- Grille uniforme à 5 colonnes fixes avec cartes cliquables -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-5">
            {categorySkills.map((skill) => {
              const FallbackIcon = lucideMap[skill.lucideFallback] || Terminal;
              return (
                <button
                  type="button"
                  class="skill-card bg-white dark:bg-[#18181B] rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-[#27272A] shadow-card hover:shadow-card-hover hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-500 transition-all duration-200 flex flex-col items-center justify-center text-center gap-3 group min-h-[120px] cursor-pointer w-full focus:outline-none focus:ring-2 focus:ring-zinc-900/40"
                  data-name={skill.name}
                  data-description={skill.description}
                  data-category={cat.title}
                  title={`Cliquer pour voir la description de ${skill.name}`}
                >
                  
                  <!-- Conteneur d'icône plus spacieux -->
                  <div class="skill-icon-source w-14 h-14 rounded-xl bg-slate-50 dark:bg-zinc-900 group-hover:bg-zinc-100 dark:group-hover:bg-zinc-800 flex items-center justify-center text-slate-700 dark:text-zinc-300 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-colors">
                    {skill.iconKey ? (
                      <i
                        class={`${skill.iconKey} colored text-3xl transition-transform group-hover:scale-110`}
                        title={skill.name}
                      ></i>
                    ) : (skill.customIcon && customSvgMap[skill.customIcon]) ? (
                      <div
                        class="w-8 h-8 flex items-center justify-center transition-transform group-hover:scale-110 [&>svg]:w-full [&>svg]:h-full [&>svg]:object-contain"
                        set:html={customSvgMap[skill.customIcon]}
                      />
                    ) : skill.customIcon ? (
                      <img
                        src={skill.customIcon}
                        alt={skill.name}
                        class="w-8 h-8 object-contain transition-transform group-hover:scale-110"
                        loading="lazy"
                      />
                    ) : (
                      <FallbackIcon class="w-7 h-7 transition-transform group-hover:scale-110" />
                    )}
                  </div>

                  <!-- Nom clair et lisible de la compétence -->
                  <span class="text-sm font-semibold text-slate-700 dark:text-zinc-300 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-colors leading-snug">
                    {skill.name}
                  </span>

                </button>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Fenêtre modale descriptive rapide de la compétence avec navigation latérale centrée -->
  <div
    id="skill-modal-backdrop"
    class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4 sm:p-6"
    aria-hidden="true"
  >
    <!-- Conteneur relatif pour positionner les flèches flottantes dans le vide de chaque côté -->
    <div class="relative w-full max-w-md flex items-center justify-center pointer-events-none">

      <!-- Flèche flottante Gauche (centrée verticalement dans le vide à gauche) -->
      <button
        id="skill-modal-prev-float"
        type="button"
        aria-label="Compétence précédente"
        title="Compétence précédente (Flèche gauche)"
        class="hidden sm:flex pointer-events-auto absolute -left-14 md:-left-20 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white dark:bg-[#18181B] text-zinc-800 dark:text-zinc-200 hover:text-black dark:hover:text-white border border-slate-200/90 dark:border-[#27272A] shadow-xl hover:shadow-2xl hover:scale-110 active:scale-95 transition-all duration-200 items-center justify-center cursor-pointer z-50 disabled:opacity-0 disabled:pointer-events-none group"
      >
        <ChevronLeft class="w-6 h-6 transition-transform group-hover:-translate-x-0.5" />
      </button>

      <!-- Carte principale de la modale épurée et aérée -->
      <div
        id="skill-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="skill-modal-title"
        class="pointer-events-auto bg-white dark:bg-[#18181B] rounded-3xl p-6 sm:p-8 w-full shadow-2xl border border-slate-200 dark:border-[#27272A] transform scale-95 transition-all duration-200 relative flex flex-col items-center text-center"
      >
        <!-- Compteur de position en haut à gauche (à l'opposé de la croix) -->
        <span
          id="skill-modal-counter"
          class="absolute top-5 left-6 text-xs font-semibold text-slate-400 dark:text-zinc-500 select-none tracking-wide"
        ></span>

        <!-- Bouton de fermeture instantanée avec croix, isolé et élégant -->
        <button
          id="skill-modal-close"
          type="button"
          aria-label="Fermer la fiche"
          title="Fermer (Échap)"
          class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-zinc-200 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none cursor-pointer"
        >
          <X class="w-5 h-5" />
        </button>

        <!-- Grande icône au centre (mise en valeur sans encombrement en haut) -->
        <div
          id="skill-modal-icon-container"
          class="w-20 h-20 rounded-2xl bg-slate-50 dark:bg-zinc-900 border border-slate-100 dark:border-zinc-800 flex items-center justify-center mt-2 mb-4 text-slate-700 dark:text-zinc-300 shadow-inner"
        >
        </div>

        <!-- Nom de la compétence en grand -->
        <h3 id="skill-modal-title" class="text-2xl font-black font-title text-slate-900 dark:text-zinc-100 tracking-tight mb-3"></h3>

        <!-- Description courte et accessible du rôle de l'outil -->
        <p id="skill-modal-description" class="text-sm text-slate-600 dark:text-zinc-400 leading-relaxed font-normal"></p>

        <!-- Navigation mobile compacte de secours (visible uniquement sur smartphone) -->
        <div class="sm:hidden w-full flex items-center justify-between pt-3 mt-3 border-t border-slate-100 dark:border-zinc-800">
          <button
            id="skill-modal-prev-mobile"
            type="button"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 text-xs font-semibold disabled:opacity-30 disabled:pointer-events-none"
          >
            <ChevronLeft class="w-3.5 h-3.5" />
            <span>Précédente</span>
          </button>

          <button
            id="skill-modal-next-mobile"
            type="button"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 text-xs font-semibold disabled:opacity-30 disabled:pointer-events-none"
          >
            <span>Suivante</span>
            <ChevronRight class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>

      <!-- Flèche flottante Droite (centrée verticalement dans le vide à droite) -->
      <button
        id="skill-modal-next-float"
        type="button"
        aria-label="Compétence suivante"
        title="Compétence suivante (Flèche droite)"
        class="hidden sm:flex pointer-events-auto absolute -right-14 md:-right-20 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white dark:bg-[#18181B] text-zinc-800 dark:text-zinc-200 hover:text-black dark:hover:text-white border border-slate-200/90 dark:border-[#27272A] shadow-xl hover:shadow-2xl hover:scale-110 active:scale-95 transition-all duration-200 items-center justify-center cursor-pointer z-50 disabled:opacity-0 disabled:pointer-events-none group"
      >
        <ChevronRight class="w-6 h-6 transition-transform group-hover:translate-x-0.5" />
      </button>

    </div>
  </div>
</section>

<!-- Script interactif d'ouverture et navigation fluide de la modale de compétences -->
<script>
  const modalBackdrop = document.getElementById('skill-modal-backdrop');
  const modalCard = document.getElementById('skill-modal-card');
  const modalClose = document.getElementById('skill-modal-close');
  const modalIconContainer = document.getElementById('skill-modal-icon-container');
  const modalTitle = document.getElementById('skill-modal-title');
  const modalDescription = document.getElementById('skill-modal-description');
  const modalCounter = document.getElementById('skill-modal-counter');

  // Flèches flottantes latérales
  const prevBtnFloat = document.getElementById('skill-modal-prev-float') as HTMLButtonElement | null;
  const nextBtnFloat = document.getElementById('skill-modal-next-float') as HTMLButtonElement | null;

  // Boutons mobiles compacts
  const prevBtnMobile = document.getElementById('skill-modal-prev-mobile') as HTMLButtonElement | null;
  const nextBtnMobile = document.getElementById('skill-modal-next-mobile') as HTMLButtonElement | null;

  const skillButtons = Array.from(document.querySelectorAll('.skill-card')) as HTMLElement[];
  let currentSkillIndex = 0;

  // Mise à jour de l'état des contrôles et du compteur
  function updateSkillControls() {
    const total = skillButtons.length;
    const current = currentSkillIndex + 1;

    if (modalCounter) {
      modalCounter.textContent = `${current} / ${total}`;
    }

    const isFirst = currentSkillIndex <= 0;
    const isLast = currentSkillIndex >= total - 1;

    if (prevBtnFloat) prevBtnFloat.disabled = isFirst;
    if (nextBtnFloat) nextBtnFloat.disabled = isLast;
    if (prevBtnMobile) prevBtnMobile.disabled = isFirst;
    if (nextBtnMobile) nextBtnMobile.disabled = isLast;
  }

  function renderSkillData(btn: HTMLElement) {
    const name = btn.getAttribute('data-name') || '';
    const description = btn.getAttribute('data-description') || '';
    const iconSource = btn.querySelector('.skill-icon-source');

    if (modalTitle) modalTitle.textContent = name;
    if (modalDescription) modalDescription.textContent = description;

    if (modalIconContainer && iconSource) {
      modalIconContainer.innerHTML = iconSource.innerHTML;
      // Ajustement de taille de l'icône dans la modale
      const customDiv = modalIconContainer.querySelector('div');
      if (customDiv) {
        customDiv.className = 'w-12 h-12 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:object-contain';
      }
      const img = modalIconContainer.querySelector('img');
      if (img) {
        img.className = 'w-12 h-12 object-contain';
      }
      const i = modalIconContainer.querySelector('i');
      if (i) {
        i.className = i.className.replace('text-3xl', 'text-5xl');
      }
      const svg = modalIconContainer.querySelector('svg');
      if (svg) {
        svg.setAttribute('class', 'w-12 h-12 object-contain');
      }
    }

    updateSkillControls();
  }

  function navigateSkill(offset: number) {
    const nextIndex = currentSkillIndex + offset;
    if (nextIndex >= 0 && nextIndex < skillButtons.length) {
      currentSkillIndex = nextIndex;
      renderSkillData(skillButtons[currentSkillIndex]);
    }
  }

  function openSkillModal(btn: HTMLElement) {
    if (!modalBackdrop || !modalCard) return;

    const foundIndex = skillButtons.indexOf(btn);
    if (foundIndex !== -1) {
      currentSkillIndex = foundIndex;
    }

    renderSkillData(btn);

    modalBackdrop.classList.remove('hidden');
    setTimeout(() => {
      modalBackdrop.classList.add('opacity-100');
      modalCard.classList.remove('scale-95');
      modalCard.classList.add('scale-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeSkillModal() {
    if (!modalBackdrop || !modalCard) return;
    modalBackdrop.classList.remove('opacity-100');
    modalCard.classList.remove('scale-100');
    modalCard.classList.add('scale-95');
    setTimeout(() => {
      modalBackdrop.classList.add('hidden');
    }, 200);
    document.body.style.overflow = '';
  }

  // Écouteurs d'événements de clic sur les cartes
  skillButtons.forEach((btn) => {
    btn.addEventListener('click', () => openSkillModal(btn));
  });

  // Navigation via les flèches flottantes latérales
  if (prevBtnFloat) prevBtnFloat.addEventListener('click', () => navigateSkill(-1));
  if (nextBtnFloat) nextBtnFloat.addEventListener('click', () => navigateSkill(1));

  // Navigation mobile
  if (prevBtnMobile) prevBtnMobile.addEventListener('click', () => navigateSkill(-1));
  if (nextBtnMobile) nextBtnMobile.addEventListener('click', () => navigateSkill(1));

  if (modalClose) {
    modalClose.addEventListener('click', closeSkillModal);
  }

  if (modalBackdrop) {
    modalBackdrop.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) {
        closeSkillModal();
      }
    });
  }

  // Navigation au clavier pour un confort maximal
  window.addEventListener('keydown', (e) => {
    if (!modalBackdrop || modalBackdrop.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeSkillModal();
    } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      navigateSkill(1);
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      navigateSkill(-1);
    }
  });
</script>
