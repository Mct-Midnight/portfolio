---
// Pied de page du Portfolio BTS SIO SLAM avec liens juridiques et conformité CNIL
import profileData from '../content/data/profile.json';
import { Scale, GitBranch } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const { identity } = profileData;
---

<footer class="mt-20 py-8 border-t border-slate-200 dark:border-zinc-800 text-xs text-slate-500 dark:text-zinc-400">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="space-y-1 text-center sm:text-left">
      <p class="font-semibold text-slate-900 dark:text-zinc-100 font-title flex items-center justify-center sm:justify-start gap-2 flex-wrap">
        <span>Portfolio {identity.firstName} {identity.lastName}</span>
        <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600 shrink-0" aria-hidden="true"></span>
        <span>BTS SIO Option SLAM</span>
      </p>
      <p class="text-slate-400 dark:text-zinc-500 flex items-center justify-center sm:justify-start gap-2 flex-wrap">
        <span>Formation préparée avec le CNED</span>
        <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600 shrink-0" aria-hidden="true"></span>
        <span>Référentiel national du BTS SIO (Session 2026-2028)</span>
      </p>
    </div>

    <!-- Liens juridiques et traçabilité Git -->
    <div class="flex items-center flex-wrap justify-center sm:justify-end gap-2.5 shrink-0">
      {currentPath !== '/journal' && (
        <a
          href="/journal"
          class="inline-flex items-center gap-1.5 font-medium text-slate-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors py-1.5 px-2.5 rounded-lg hover:bg-slate-100 dark:hover:bg-zinc-800"
          title="Consulter l'historique des livraisons Git et de maintenance du portfolio"
        >
          <GitBranch class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500" />
          <span>Journal Git</span>
        </a>
      )}

      {currentPath !== '/mentions-legales' ? (
        <a
          href="/mentions-legales"
          class="inline-flex items-center gap-1.5 font-medium text-slate-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors py-1.5 px-2.5 rounded-lg hover:bg-slate-100 dark:hover:bg-zinc-800"
        >
          <Scale class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500" />
          <span>Mentions Légales</span>
        </a>
      ) : (
        <a
          href="/"
          class="inline-flex items-center gap-1.5 font-medium text-slate-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors py-1.5 px-2.5 rounded-lg hover:bg-slate-100 dark:hover:bg-zinc-800"
        >
          <span>← Accueil du portfolio</span>
        </a>
      )}
    </div>
  </div>
</footer>
