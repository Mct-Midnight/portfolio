---
// Pied de page épuré du portfolio avec copyright officiel et liens de navigation sobres
import profileData from '../content/data/profile.json';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const { identity } = profileData;
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 py-8 border-t border-slate-200 dark:border-zinc-800 text-xs text-slate-500 dark:text-zinc-400">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
    <!-- Mention légale de copyright et filière -->
    <div class="flex flex-col sm:flex-row items-center gap-1.5 sm:gap-3">
      <span class="font-medium text-slate-700 dark:text-zinc-300">
        &copy; {currentYear} {identity.firstName} {identity.lastName}. Tous droits réservés.
      </span>
      <span class="hidden sm:inline-block w-1 h-1 rounded-full bg-slate-300 dark:bg-zinc-700" aria-hidden="true"></span>
      <span class="text-slate-400 dark:text-zinc-500">
        BTS SIO SLAM
      </span>
    </div>

    <!-- Liens de navigation épurés -->
    <nav class="flex flex-wrap items-center justify-center gap-6" aria-label="Liens secondaires de pied de page">
      {currentPath !== '/' && currentPath !== '' && (
        <a
          href="/"
          class="hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          Accueil
        </a>
      )}

      {currentPath !== '/journal' && (
        <a
          href="/journal"
          class="hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          Journal Git
        </a>
      )}

      {currentPath !== '/mentions-legales' && (
        <a
          href="/mentions-legales"
          class="hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          Mentions Légales
        </a>
      )}
    </nav>
  </div>
</footer>

