---
// Composant : Fiche Synthèse Entreprise & RH (Recherche de Stage SLAM 2027)
// Format Executive One-Pager épuré, pensé pour une lecture instantanée par les tuteurs et services RH.
import {
  Printer,
  X,
  ShieldCheck,
  Calendar,
  Clock,
  MapPin,
  Laptop,
  Code2,
  Database,
  Workflow,
  ClipboardCheck,
  Phone,
  Mail,
  Linkedin,
  Github,
  Download,
  Building2,
  Check,
  Sparkles,
  ArrowUpRight
} from 'lucide-astro';
import profileData from '../content/data/profile.json';

const { identity, contact, internshipSearch } = profileData;
---

<!-- Conteneur Modale d'Information Entreprise & RH -->
<div
  id="stage-recap-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-5 overflow-y-auto hidden opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="stage-modal-title"
  aria-hidden="true"
>
  <!-- Arrière-plan semi-transparent avec flou d'ambiance (Backdrop) -->
  <div
    id="stage-modal-backdrop"
    class="modal-backdrop fixed inset-0 bg-zinc-950/70 backdrop-blur-sm transition-opacity cursor-pointer"
    aria-hidden="true"
  ></div>

  <!-- Boîte modale exécutive épurée (Fact Sheet) -->
  <div
    class="modal-container relative w-full max-w-3xl bg-white dark:bg-[#18181B] text-zinc-900 dark:text-zinc-100 rounded-2xl shadow-2xl border border-zinc-200/90 dark:border-[#27272A] overflow-hidden my-auto flex flex-col max-h-[94vh] z-10 transition-all duration-200 scale-95"
    id="stage-modal-box"
  >
    <!-- 1. En-tête minimaliste & statut exécutif -->
    <header class="px-6 py-4 bg-white dark:bg-[#18181B] border-b border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between gap-4 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
          <Building2 class="w-4 h-4" />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 id="stage-modal-title" class="text-base font-bold font-title tracking-tight text-zinc-900 dark:text-zinc-100">
              Fiche Synthèse — Stage SLAM 2027
            </h2>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              Gratification : 0 €
            </span>
          </div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            {identity.firstName} {identity.lastName} • 1re Année BTS SIO (SLAM) • CNED
          </p>
        </div>
      </div>

      <!-- Boutons d'action : Imprimer / Fermer -->
      <div class="flex items-center gap-1.5 print-hide">
        <button
          type="button"
          id="stage-modal-print-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 transition-colors cursor-pointer"
          title="Imprimer ou exporter la fiche au format PDF"
        >
          <Printer class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Imprimer PDF</span>
        </button>

        <button
          type="button"
          id="stage-modal-close-btn"
          class="p-1.5 rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          aria-label="Fermer la fiche"
          title="Fermer (Échap)"
        >
          <X class="w-5 h-5" />
        </button>
      </div>
    </header>

    <!-- 2. Corps défilable : Métriques clés + Colonnes synthétiques -->
    <div class="modal-scroll-area overflow-y-auto p-5 sm:p-6 space-y-5 flex-1">
      
      <!-- Bandeau des 4 KPIs Stratégiques (Réponse instantanée aux questions RH) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 print-kpi-grid">
        
        <!-- KPI 1 : Gratification 0€ -->
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/70 dark:border-zinc-800">
          <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400 mb-1">
            <span class="text-[10px] font-bold uppercase tracking-wider font-title">Gratification</span>
            <Check class="w-3 h-3 text-emerald-600 dark:text-emerald-400" />
          </div>
          <p class="text-lg font-bold font-title text-zinc-900 dark:text-zinc-100 leading-tight">0 € requis</p>
          <p class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-0.5">&lt; 308h (art. L124-6)</p>
        </div>

        <!-- KPI 2 : Durée opérationnelle -->
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/70 dark:border-zinc-800">
          <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400 mb-1">
            <span class="text-[10px] font-bold uppercase tracking-wider font-title">Durée</span>
            <Clock class="w-3 h-3 text-zinc-400" />
          </div>
          <p class="text-lg font-bold font-title text-zinc-900 dark:text-zinc-100 leading-tight">4 à 5 sem.</p>
          <p class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-0.5">Temps plein (35h/sem.)</p>
        </div>

        <!-- KPI 3 : Période flexible -->
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/70 dark:border-zinc-800">
          <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400 mb-1">
            <span class="text-[10px] font-bold uppercase tracking-wider font-title">Période</span>
            <Calendar class="w-3 h-3 text-zinc-400" />
          </div>
          <p class="text-lg font-bold font-title text-zinc-900 dark:text-zinc-100 leading-tight">Mai — Août</p>
          <p class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-0.5">2027 (dates modulables)</p>
        </div>

        <!-- KPI 4 : Convention & Sécurité -->
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/70 dark:border-zinc-800">
          <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400 mb-1">
            <span class="text-[10px] font-bold uppercase tracking-wider font-title">Sécurité</span>
            <ShieldCheck class="w-3 h-3 text-zinc-400" />
          </div>
          <p class="text-lg font-bold font-title text-zinc-900 dark:text-zinc-100 leading-tight">CNED</p>
          <p class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-0.5">Convention + Assurance RC</p>
        </div>

      </div>

      <!-- Grille à 2 colonnes aérées : Cadre de collaboration vs Compétences concrètes -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <!-- Colonne Gauche : Cadre Administratif, Financier & Mobilité -->
        <div class="space-y-4">
          
          <!-- Bloc Cadre Légal & Gratification -->
          <div class="p-4 rounded-xl bg-white dark:bg-zinc-900/40 border border-zinc-200/70 dark:border-zinc-800 space-y-3">
            <div class="flex items-center gap-2">
              <ShieldCheck class="w-4 h-4 text-zinc-900 dark:text-zinc-100" />
              <h3 class="text-xs font-bold font-title uppercase tracking-wider text-zinc-900 dark:text-zinc-100">
                Cadre Légal & Prise en Charge
              </h3>
            </div>

            <ul class="space-y-2 text-xs text-zinc-600 dark:text-zinc-400">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 shrink-0 mt-1.5"></span>
                <span><strong>Gratification facultative :</strong> Durée inférieure au seuil légal de 2 mois consécutifs (308h). Aucune obligation financière pour l'entreprise.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 shrink-0 mt-1.5"></span>
                <span><strong>Convention officielle :</strong> Convention tripartite dématérialisée délivrée par le CNED (signature électronique rapide).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 shrink-0 mt-1.5"></span>
                <span><strong>Couverture assurée :</strong> Étudiant protégé par l'assurance scolaire et la responsabilité civile tout au long du stage.</span>
              </li>
            </ul>
          </div>

          <!-- Bloc Mobilité & Modalités -->
          <div class="p-4 rounded-xl bg-white dark:bg-zinc-900/40 border border-zinc-200/70 dark:border-zinc-800 space-y-3">
            <div class="flex items-center gap-2">
              <MapPin class="w-4 h-4 text-zinc-900 dark:text-zinc-100" />
              <h3 class="text-xs font-bold font-title uppercase tracking-wider text-zinc-900 dark:text-zinc-100">
                Localisation & Modalités
              </h3>
            </div>

            <div class="grid grid-cols-2 gap-2 text-xs">
              <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
                <span class="block font-semibold text-zinc-900 dark:text-zinc-100 mb-0.5">Présentiel</span>
                <span class="text-[11px] text-zinc-500 dark:text-zinc-400">Cambrai, Valenciennes, Douai, Métropole lilloise</span>
              </div>
              <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
                <span class="block font-semibold text-zinc-900 dark:text-zinc-100 mb-0.5">Télétravail</span>
                <span class="text-[11px] text-zinc-500 dark:text-zinc-400">Total ou hybride (autonomie & culture asynchrone CNED)</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Colonne Droite : Compétences & Missions Opérationnelles -->
        <div class="p-4 rounded-xl bg-white dark:bg-zinc-900/40 border border-zinc-200/70 dark:border-zinc-800 space-y-3 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <Code2 class="w-4 h-4 text-zinc-900 dark:text-zinc-100" />
                <h3 class="text-xs font-bold font-title uppercase tracking-wider text-zinc-900 dark:text-zinc-100">
                  Missions Opérationnelles Immédiates
                </h3>
              </div>
              <span class="text-[10px] text-zinc-400 font-mono">1re année SLAM</span>
            </div>

            <!-- Liste des 4 champs techniques compacts -->
            <div class="space-y-2">
              <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
                <div class="flex items-center gap-2 font-semibold text-xs text-zinc-900 dark:text-zinc-100">
                  <Laptop class="w-3.5 h-3.5 text-zinc-600 dark:text-zinc-400 shrink-0" />
                  <span>Front-End & Intégration d'interfaces</span>
                </div>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 leading-relaxed">
                  HTML5 sémantique, Tailwind CSS, JavaScript / TypeScript, composants responsives et intégration de maquettes.
                </p>
              </div>

              <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
                <div class="flex items-center gap-2 font-semibold text-xs text-zinc-900 dark:text-zinc-100">
                  <Database class="w-3.5 h-3.5 text-zinc-600 dark:text-zinc-400 shrink-0" />
                  <span>Bases de Données & Requêtes SQL</span>
                </div>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 leading-relaxed">
                  Modélisation relationnelle (MCD/MLD), requêtage SQL (jointures, vues), mise à jour et intégrité des données.
                </p>
              </div>

              <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
                <div class="flex items-center gap-2 font-semibold text-xs text-zinc-900 dark:text-zinc-100">
                  <Workflow class="w-3.5 h-3.5 text-zinc-600 dark:text-zinc-400 shrink-0" />
                  <span>Automatisation & Scripts Utilitaires</span>
                </div>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 leading-relaxed">
                  Scripts Python, parsing de données (JSON / CSV) et interaction avec des APIs REST.
                </p>
              </div>

              <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
                <div class="flex items-center gap-2 font-semibold text-xs text-zinc-900 dark:text-zinc-100">
                  <ClipboardCheck class="w-3.5 h-3.5 text-zinc-600 dark:text-zinc-400 shrink-0" />
                  <span>Recette, Tests & Documentation</span>
                </div>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 leading-relaxed">
                  Exécution de plans de tests fonctionnels, recette des écrans, rédaction de guides utilisateurs et fiches techniques.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- 3. Pied de modale : Ligne de contact exécutive & CTA direct -->
    <footer class="px-6 py-3.5 bg-zinc-50 dark:bg-zinc-900/90 border-t border-zinc-200/80 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-3 text-xs shrink-0">
      
      <!-- Coordonnées rapides cliquables -->
      <div class="flex items-center gap-4 flex-wrap text-zinc-700 dark:text-zinc-300">
        <a
          href={`tel:${contact.phone.replace(/\s+/g, '')}`}
          class="flex items-center gap-1.5 hover:text-zinc-950 dark:hover:text-white transition-colors font-medium"
        >
          <Phone class="w-3.5 h-3.5 text-zinc-500" />
          <span>{contact.phone}</span>
        </a>

        <a
          href={`mailto:${contact.email}`}
          class="flex items-center gap-1.5 hover:text-zinc-950 dark:hover:text-white transition-colors font-medium"
        >
          <Mail class="w-3.5 h-3.5 text-zinc-500" />
          <span>{contact.email}</span>
        </a>

        <a
          href={contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 hover:text-zinc-950 dark:hover:text-white transition-colors text-zinc-500"
        >
          <Linkedin class="w-3.5 h-3.5" />
          <span>LinkedIn</span>
          <ArrowUpRight class="w-3 h-3" />
        </a>
      </div>

      <!-- Actions directes (CV & Fermer) -->
      <div class="flex items-center gap-2 print-hide">
        <a
          href={identity.cvDownloadUrl}
          download
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-zinc-900 hover:bg-black dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 transition-colors shadow-sm"
        >
          <Download class="w-3.5 h-3.5" />
          <span>Télécharger CV</span>
        </a>

        <button
          type="button"
          id="stage-modal-bottom-close-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:bg-zinc-200/70 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
        >
          Fermer
        </button>
      </div>

    </footer>
  </div>
</div>

<!-- Styles spécifiques à l'impression propre sur page A4 -->
<style>
  @media print {
    /* Masquage de tout le contenu hôte sauf la modale de synthèse */
    :global(body.stage-modal-open > *:not(#stage-recap-modal)) {
      display: none !important;
    }

    :global(body.stage-modal-open) {
      background: #ffffff !important;
      color: #09090b !important;
      padding: 0 !important;
      margin: 0 !important;
      overflow: visible !important;
    }

    :global(body.stage-modal-open) #stage-recap-modal {
      position: static !important;
      inset: auto !important;
      display: block !important;
      width: 100% !important;
      height: auto !important;
      overflow: visible !important;
      background: #ffffff !important;
      padding: 0 !important;
      margin: 0 !important;
      opacity: 1 !important;
    }

    :global(body:not(.stage-modal-open)) #stage-recap-modal {
      display: none !important;
    }

    #stage-modal-backdrop {
      display: none !important;
    }

    .modal-container {
      max-width: 100% !important;
      max-height: none !important;
      height: auto !important;
      overflow: visible !important;
      border: 1px solid #e4e4e7 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      transform: none !important;
      background: #ffffff !important;
      color: #09090b !important;
    }

    .print-hide {
      display: none !important;
    }

    .modal-scroll-area {
      overflow: visible !important;
      max-height: none !important;
      padding: 1rem !important;
      color: #09090b !important;
    }

    .print-kpi-grid {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
    }
  }
</style>

<!-- Script d'orchestration client : ouverture, fermeture et raccourci clavier Échap -->
<script>
  // Initialisation sécurisée du gestionnaire de modale
  function initStageRecapModal() {
    const modal = document.getElementById('stage-recap-modal');
    const modalBox = document.getElementById('stage-modal-box');
    const backdrop = document.getElementById('stage-modal-backdrop');
    const closeBtn = document.getElementById('stage-modal-close-btn');
    const bottomCloseBtn = document.getElementById('stage-modal-bottom-close-btn');
    const printBtn = document.getElementById('stage-modal-print-btn');

    if (!modal || !modalBox) return;

    // Déplacement de la modale en enfant direct du body pour isolation totale et impression sans faille
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    // Prévention des écouteurs redondants lors des navigations Astro
    if ((modal as any)._initialized) return;
    (modal as any)._initialized = true;

    let previousActiveElement: HTMLElement | null = null;

    // Fonction d'ouverture
    const openModal = () => {
      previousActiveElement = document.activeElement as HTMLElement;
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden', 'stage-modal-open');

      // Animation fluide d'apparition
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        modalBox.classList.remove('scale-95');
        modalBox.classList.add('scale-100');
      });

      modal.setAttribute('aria-hidden', 'false');
      closeBtn?.focus();
    };

    // Fonction de fermeture
    const closeModal = () => {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      modalBox.classList.remove('scale-100');
      modalBox.classList.add('scale-95');

      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'stage-modal-open');
        modal.setAttribute('aria-hidden', 'true');
        previousActiveElement?.focus();
      }, 200);
    };

    // Déclencheurs d'ouverture (délégation pour supporter les ajouts dynamiques)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('[data-open-stage-modal]');
      if (target) {
        e.preventDefault();
        openModal();
      }
    });

    // Événements de fermeture
    closeBtn?.addEventListener('click', closeModal);
    bottomCloseBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    // Fermeture avec la touche Échap
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Action d'impression / Enregistrement PDF
    printBtn?.addEventListener('click', () => {
      window.print();
    });
  }

  // Prise en charge des chargements initiaux et des transitions Astro
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStageRecapModal);
  } else {
    initStageRecapModal();
  }

  document.addEventListener('astro:page-load', initStageRecapModal);
</script>
