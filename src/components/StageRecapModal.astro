---
// Composant : Fiche Synthèse Entreprise & RH (Stage SLAM 2027)
// Design Executive Briefing haut de gamme : aéré, fluide et aux proportions rigoureusement harmonisées.
import {
  Printer,
  X,
  Phone,
  Mail,
  Linkedin,
  Download,
  ArrowUpRight,
  ShieldCheck,
  Calendar,
  Coins,
  MapPin,
  Laptop,
  Database,
  Workflow,
  ClipboardCheck
} from 'lucide-astro';
import profileData from '../content/data/profile.json';

const { identity, contact, internshipSearch } = profileData;
---

<!-- Conteneur Modale d'Information Entreprise & RH -->
<div
  id="stage-recap-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 overflow-y-auto hidden opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="stage-modal-title"
  aria-hidden="true"
>
  <!-- Arrière-plan sombre avec flou d'ambiance feutré -->
  <div
    id="stage-modal-backdrop"
    class="modal-backdrop fixed inset-0 bg-zinc-950/75 backdrop-blur-md transition-opacity cursor-pointer"
    aria-hidden="true"
  ></div>

  <!-- Boîte de dialogue exécutive aérée (Format Memo / Fact Sheet spacieux) -->
  <div
    class="modal-container relative w-full max-w-4xl bg-white dark:bg-[#151518] text-zinc-900 dark:text-zinc-100 rounded-2xl shadow-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden my-auto flex flex-col max-h-[92vh] z-10 transition-all duration-200 scale-95"
    id="stage-modal-box"
  >
    <!-- 1. En-tête épuré : titre en une phrase fluide sans tiret ni esperluette -->
    <header class="px-6 sm:px-8 pt-7 pb-6 border-b border-zinc-100 dark:border-zinc-800/80 flex items-start justify-between gap-4 shrink-0 bg-white dark:bg-[#151518]">
      <div>
        <h2 id="stage-modal-title" class="text-xl sm:text-2xl font-bold font-title tracking-tight text-zinc-950 dark:text-white">
          Fiche de synthèse pour l'entreprise d'accueil
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1.5">
          Candidature de <strong>{identity.firstName} {identity.lastName}</strong> pour le stage BTS SIO option SLAM au CNED
        </p>
      </div>

      <!-- Actions rapides : Imprimer / Fermer -->
      <div class="flex items-center gap-2 shrink-0 print-hide">
        <button
          type="button"
          id="stage-modal-print-btn"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          title="Imprimer ou enregistrer en PDF"
        >
          <Printer class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Imprimer PDF</span>
        </button>

        <button
          type="button"
          id="stage-modal-close-btn"
          class="p-2 rounded-lg text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          aria-label="Fermer la fiche"
          title="Fermer (Échap)"
        >
          <X class="w-5 h-5" />
        </button>
      </div>
    </header>

    <!-- 2. Corps du Memo aéré : 3 piliers + 4 compétences de dimensions identiques -->
    <div class="modal-scroll-area overflow-y-auto px-6 sm:px-8 py-7 space-y-7 flex-1">

      <!-- Section A : Les 3 Piliers Capitaux (Aérés avec espacement doux) -->
      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-3.5 font-title">
          Le Cadre en 3 Points Clés
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 print-pillars-grid">
          
          <!-- Pilier 1 : Gratification légale -->
          <div class="p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-zinc-900 dark:text-zinc-100 mb-2">
                <Coins class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
                <span class="text-xs font-bold font-title">Gratification</span>
              </div>
              <p class="text-2xl font-bold font-title tracking-tight text-zinc-950 dark:text-white">
                0 € légal
              </p>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1.5 leading-relaxed">
                Durée inférieure au seuil de 2 mois (308h - art. L124-6). Gratification facultative.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800 text-[10px] text-zinc-500 font-medium">
              Zéro charge financière imposée
            </div>
          </div>

          <!-- Pilier 2 : Durée & Période -->
          <div class="p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-zinc-900 dark:text-zinc-100 mb-2">
                <Calendar class="w-4 h-4 text-zinc-700 dark:text-zinc-300" />
                <span class="text-xs font-bold font-title">Calendrier</span>
              </div>
              <p class="text-2xl font-bold font-title tracking-tight text-zinc-950 dark:text-white">
                4 à 5 sem.
              </p>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1.5 leading-relaxed">
                Période de Mai à Août 2027. Dates adaptables selon les impératifs de vos projets.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800 text-[10px] text-zinc-500 font-medium">
              Temps plein (35h / semaine)
            </div>
          </div>

          <!-- Pilier 3 : Convention & Sécurité Juridique -->
          <div class="p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-zinc-900 dark:text-zinc-100 mb-2">
                <ShieldCheck class="w-4 h-4 text-zinc-700 dark:text-zinc-300" />
                <span class="text-xs font-bold font-title">Cadre Légal</span>
              </div>
              <p class="text-2xl font-bold font-title tracking-tight text-zinc-950 dark:text-white">
                100% Cadré
              </p>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1.5 leading-relaxed">
                Convention tripartite délivrée par le CNED. Assurance scolaire & responsabilité civile actives.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800 text-[10px] text-zinc-500 font-medium">
              Signature électronique rapide
            </div>
          </div>

        </div>
      </div>

      <!-- Section B : Compétences & Missions Opérationnelles (Cases strictement symétriques et égalisées) -->
      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-title mb-3.5">
          Missions & Compétences Directes (1re Année SLAM)
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-stretch">
          
          <!-- Compétence 1 : Front-End -->
          <div class="p-5 rounded-xl bg-white dark:bg-zinc-900/30 border border-zinc-200/80 dark:border-zinc-800 flex flex-col justify-between h-full hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-3 mb-2.5">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <Laptop class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 font-title">
                Front-End & Intégration Web
              </h3>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed flex-1">
              Conception d'interfaces web responsives et modernes, intégration rigoureuse de maquettes et composants UI réutilisables.
            </p>
          </div>

          <!-- Compétence 2 : Bases de données -->
          <div class="p-5 rounded-xl bg-white dark:bg-zinc-900/30 border border-zinc-200/80 dark:border-zinc-800 flex flex-col justify-between h-full hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-3 mb-2.5">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <Database class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 font-title">
                Bases de Données & Requêtes SQL
              </h3>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed flex-1">
              Modélisation relationnelle (MCD/MLD), écriture de requêtes SQL optimisées, contrôle d'intégrité et manipulation de données.
            </p>
          </div>

          <!-- Compétence 3 : Automatisation & Python -->
          <div class="p-5 rounded-xl bg-white dark:bg-zinc-900/30 border border-zinc-200/80 dark:border-zinc-800 flex flex-col justify-between h-full hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-3 mb-2.5">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <Workflow class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 font-title">
                Automatisation & Scripts Utilitaires
              </h3>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed flex-1">
              Création de scripts d'automatisation en Python, traitement de flux de données (JSON/CSV) et connexion aux APIs REST.
            </p>
          </div>

          <!-- Compétence 4 : Recette & Tests -->
          <div class="p-5 rounded-xl bg-white dark:bg-zinc-900/30 border border-zinc-200/80 dark:border-zinc-800 flex flex-col justify-between h-full hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-3 mb-2.5">
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100 shrink-0">
                <ClipboardCheck class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 font-title">
                Recette, Tests & Documentation
              </h3>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed flex-1">
              Exécution de plans de tests fonctionnels, recette des écrans utilisateurs, rédaction de guides réflexes et fiches techniques.
            </p>
          </div>

        </div>
      </div>

      <!-- Section C : Modalités de travail centrées et aérées -->
      <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-900/40 border border-zinc-200/70 dark:border-zinc-800/80 flex flex-col sm:flex-row sm:items-center justify-center gap-5 sm:gap-10 text-xs">
        <div class="flex items-center gap-2 text-zinc-700 dark:text-zinc-300">
          <MapPin class="w-4 h-4 text-zinc-900 dark:text-zinc-100 shrink-0" />
          <span><strong>Présentiel :</strong> Cambrai (Hauts-de-France)</span>
        </div>
        <div class="hidden sm:block w-px h-4 bg-zinc-300 dark:bg-zinc-700" aria-hidden="true"></div>
        <div class="flex items-center gap-2 text-zinc-700 dark:text-zinc-300">
          <Laptop class="w-4 h-4 text-zinc-900 dark:text-zinc-100 shrink-0" />
          <span><strong>Télétravail :</strong> Total ou hybride (autonomie CNED)</span>
        </div>
      </div>

    </div>

    <!-- 3. Pied de modale : Ligne de contact direct & Téléchargement CV -->
    <footer class="px-6 sm:px-8 py-4.5 bg-zinc-950 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs shrink-0">
      
      <!-- Coordonnées directes -->
      <div class="flex items-center gap-5 flex-wrap text-zinc-300">
        <a
          href={`tel:${contact.phone.replace(/\s+/g, '')}`}
          class="flex items-center gap-1.5 hover:text-white transition-colors font-medium"
        >
          <Phone class="w-3.5 h-3.5 text-zinc-400" />
          <span>{contact.phone}</span>
        </a>

        <a
          href={`mailto:${contact.email}`}
          class="flex items-center gap-1.5 hover:text-white transition-colors font-medium"
        >
          <Mail class="w-3.5 h-3.5 text-zinc-400" />
          <span>{contact.email}</span>
        </a>

        <a
          href={contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 hover:text-white transition-colors text-zinc-400"
        >
          <Linkedin class="w-3.5 h-3.5" />
          <span>LinkedIn</span>
          <ArrowUpRight class="w-3 h-3" />
        </a>
      </div>

      <!-- Actions de fin -->
      <div class="flex items-center gap-2.5 print-hide">
        <a
          href={identity.cvDownloadUrl}
          download
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-zinc-950 hover:bg-zinc-100 transition-colors shadow-sm"
        >
          <Download class="w-3.5 h-3.5" />
          <span>Télécharger CV</span>
        </a>

        <button
          type="button"
          id="stage-modal-bottom-close-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white hover:bg-zinc-900 transition-colors cursor-pointer"
        >
          Fermer
        </button>
      </div>

    </footer>
  </div>
</div>

<!-- Styles spécifiques à l'impression propre sur page A4 -->
<style>
  @media print {
    /* Masquage de tout le contenu hôte sauf la modale de synthèse */
    :global(body.stage-modal-open > *:not(#stage-recap-modal)) {
      display: none !important;
    }

    :global(body.stage-modal-open) {
      background: #ffffff !important;
      color: #09090b !important;
      padding: 0 !important;
      margin: 0 !important;
      overflow: visible !important;
    }

    :global(body.stage-modal-open) #stage-recap-modal {
      position: static !important;
      inset: auto !important;
      display: block !important;
      width: 100% !important;
      height: auto !important;
      overflow: visible !important;
      background: #ffffff !important;
      padding: 0 !important;
      margin: 0 !important;
      opacity: 1 !important;
    }

    :global(body:not(.stage-modal-open)) #stage-recap-modal {
      display: none !important;
    }

    #stage-modal-backdrop {
      display: none !important;
    }

    .modal-container {
      max-width: 100% !important;
      max-height: none !important;
      height: auto !important;
      overflow: visible !important;
      border: 1px solid #e4e4e7 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      transform: none !important;
      background: #ffffff !important;
      color: #09090b !important;
    }

    .print-hide {
      display: none !important;
    }

    .modal-scroll-area {
      overflow: visible !important;
      max-height: none !important;
      padding: 1.5rem !important;
      color: #09090b !important;
    }

    .print-pillars-grid {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
</style>

<!-- Script d'orchestration client : ouverture, fermeture et raccourci clavier Échap -->
<script>
  // Initialisation sécurisée du gestionnaire de modale
  function initStageRecapModal() {
    const modal = document.getElementById('stage-recap-modal');
    const modalBox = document.getElementById('stage-modal-box');
    const backdrop = document.getElementById('stage-modal-backdrop');
    const closeBtn = document.getElementById('stage-modal-close-btn');
    const bottomCloseBtn = document.getElementById('stage-modal-bottom-close-btn');
    const printBtn = document.getElementById('stage-modal-print-btn');

    if (!modal || !modalBox) return;

    // Déplacement de la modale en enfant direct du body pour isolation totale et impression sans faille
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    // Prévention des écouteurs redondants lors des navigations Astro
    if ((modal as any)._initialized) return;
    (modal as any)._initialized = true;

    let previousActiveElement: HTMLElement | null = null;

    // Fonction d'ouverture
    const openModal = () => {
      previousActiveElement = document.activeElement as HTMLElement;
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden', 'stage-modal-open');

      // Animation fluide d'apparition
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        modalBox.classList.remove('scale-95');
        modalBox.classList.add('scale-100');
      });

      modal.setAttribute('aria-hidden', 'false');
      closeBtn?.focus();
    };

    // Fonction de fermeture
    const closeModal = () => {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      modalBox.classList.remove('scale-100');
      modalBox.classList.add('scale-95');

      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'stage-modal-open');
        modal.setAttribute('aria-hidden', 'true');
        previousActiveElement?.focus();
      }, 200);
    };

    // Déclencheurs d'ouverture (délégation pour supporter les ajouts dynamiques)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('[data-open-stage-modal]');
      if (target) {
        e.preventDefault();
        openModal();
      }
    });

    // Événements de fermeture
    closeBtn?.addEventListener('click', closeModal);
    bottomCloseBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    // Fermeture avec la touche Échap
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Action d'impression / Enregistrement PDF
    printBtn?.addEventListener('click', () => {
      window.print();
    });
  }

  // Prise en charge des chargements initiaux et des transitions Astro
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStageRecapModal);
  } else {
    initStageRecapModal();
  }

  document.addEventListener('astro:page-load', initStageRecapModal);
</script>
