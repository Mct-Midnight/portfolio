---
import { MapPin, Phone, Mail, Github, Linkedin, Send, CheckCircle2, MessageSquare, User, AtSign, Tag, ShieldCheck, ChevronDown, X } from 'lucide-astro';
import profileData from '../content/data/profile.json';

const { identity, contact } = profileData;
---

<section id="contact" class="py-16 scroll-mt-20 border-t border-slate-200 dark:border-zinc-800">
  
  <!-- En-tête de section sans sous-titre redondant -->
  <div class="mb-12">
    <h2 class="text-3xl font-bold font-title text-slate-900 dark:text-zinc-100 tracking-tight">
      Me Contacter
    </h2>
    <p class="text-sm text-slate-600 dark:text-zinc-400 mt-2 max-w-2xl">
      Disponible pour échanger au sujet d'une opportunité de stage, d'un projet freelance ou d'une collaboration technique.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    
    <!-- Colonne Gauche : Pile de Cartes de Coordonnées alignée en hauteur -->
    <div class="lg:col-span-5 flex flex-col gap-3.5 lg:h-full">
      
      <!-- Carte Localisation -->
      <div class="flex-1 min-h-[76px] bg-white dark:bg-[#18181B] p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-[#27272A] shadow-card flex items-center gap-4 hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0">
          <MapPin class="w-5 h-5" />
        </div>
        <div>
          <span class="text-xs text-slate-500 dark:text-zinc-400 font-medium block">Localisation géographique</span>
          <span class="text-sm font-bold text-slate-900 dark:text-zinc-100">{contact.city}</span>
        </div>
      </div>

      <!-- Carte Email -->
      <a
        href={`mailto:${contact.email}`}
        class="flex-1 min-h-[76px] bg-white dark:bg-[#18181B] p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-[#27272A] shadow-card flex items-center gap-4 hover:border-zinc-400 dark:hover:border-zinc-500 group transition-all"
      >
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0 group-hover:bg-zinc-900 group-hover:text-white dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-950 group-hover:border-zinc-900 dark:group-hover:border-zinc-100 transition-colors">
          <Mail class="w-5 h-5" />
        </div>
        <div class="overflow-hidden">
          <span class="text-xs text-slate-500 dark:text-zinc-400 font-medium block">Adresse électronique</span>
          <span class="text-sm font-bold text-slate-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors truncate block">
            {contact.email}
          </span>
        </div>
      </a>

      <!-- Carte Téléphone -->
      <a
        href={`tel:${contact.phone.replace(/\s+/g, '')}`}
        class="flex-1 min-h-[76px] bg-white dark:bg-[#18181B] p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-[#27272A] shadow-card flex items-center gap-4 hover:border-zinc-400 dark:hover:border-zinc-500 group transition-all"
      >
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0 group-hover:bg-zinc-900 group-hover:text-white dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-950 group-hover:border-zinc-900 dark:group-hover:border-zinc-100 transition-colors">
          <Phone class="w-5 h-5" />
        </div>
        <div>
          <span class="text-xs text-slate-500 dark:text-zinc-400 font-medium block">Téléphone portable</span>
          <span class="text-sm font-bold text-slate-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
            {contact.phone}
          </span>
        </div>
      </a>

      <!-- Carte LinkedIn -->
      <a
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 min-h-[76px] bg-white dark:bg-[#18181B] p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-[#27272A] shadow-card flex items-center gap-4 hover:border-zinc-400 dark:hover:border-zinc-500 group transition-all"
      >
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0 group-hover:bg-zinc-900 group-hover:text-white dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-950 group-hover:border-zinc-900 dark:group-hover:border-zinc-100 transition-colors">
          <Linkedin class="w-5 h-5" />
        </div>
        <div>
          <span class="text-xs text-slate-500 dark:text-zinc-400 font-medium block">Réseau professionnel</span>
          <span class="text-sm font-bold text-slate-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
            LinkedIn / {identity.firstName} {identity.lastName}
          </span>
        </div>
      </a>

      <!-- Carte Discord -->
      <a
        href={contact.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 min-h-[76px] bg-white dark:bg-[#18181B] p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-[#27272A] shadow-card flex items-center gap-4 hover:border-zinc-400 dark:hover:border-zinc-500 group transition-all"
      >
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0 group-hover:bg-zinc-900 group-hover:text-white dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-950 group-hover:border-zinc-900 dark:group-hover:border-zinc-100 transition-colors">
          <!-- Icône vectorielle Discord monochrome mat -->
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs text-slate-500 dark:text-zinc-400 font-medium block">Messagerie tech & Collaboration</span>
          <span class="text-sm font-bold text-slate-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
            Discord / @{contact.discordUsername}
          </span>
        </div>
      </a>

      <!-- Carte GitHub -->
      <a
        href={contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 min-h-[76px] bg-white dark:bg-[#18181B] p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-[#27272A] shadow-card flex items-center gap-4 hover:border-zinc-400 dark:hover:border-zinc-500 group transition-all"
      >
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0 group-hover:bg-zinc-900 group-hover:text-white dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-950 group-hover:border-zinc-900 dark:group-hover:border-zinc-100 transition-colors">
          <Github class="w-5 h-5" />
        </div>
        <div>
          <span class="text-xs text-slate-500 dark:text-zinc-400 font-medium block">Dépôts & Code source</span>
          <span class="text-sm font-bold text-slate-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
            {contact.github.replace(/^https?:\/\//, '')}
          </span>
        </div>
      </a>

    </div>

    <!-- Colonne Droite : Formulaire de Contact Interactif -->
    <div class="lg:col-span-7 lg:h-full flex flex-col">
      <div class="bg-white dark:bg-[#18181B] p-6 sm:p-8 rounded-2xl border border-slate-200 dark:border-[#27272A] shadow-card lg:h-full flex flex-col">
        
        <div class="mb-5">
          <h3 class="text-lg font-bold font-title text-slate-900 dark:text-zinc-100">Formulaire de Prise de Contact</h3>
          <p class="text-xs text-slate-500 dark:text-zinc-400 mt-1">Tous les champs sont requis pour assurer un suivi personnalisé de votre demande.</p>
        </div>

        <form id="contact-form" class="flex-1 flex flex-col justify-between gap-4">
          
          <!-- Ligne 1 : Nom et Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-bold font-title text-slate-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
                Nom & Prénom <span class="text-zinc-900 dark:text-zinc-100">*</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Jean Dupont"
                  class="w-full px-3.5 py-2.5 pl-10 rounded-xl border border-slate-300 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-zinc-900/20 dark:focus:ring-zinc-100/20 focus:border-zinc-900 dark:focus:border-zinc-400 text-sm bg-slate-50 dark:bg-zinc-900 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 transition-colors"
                />
                <User class="w-4 h-4 text-slate-400 dark:text-zinc-500 absolute left-3.5 top-3" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-bold font-title text-slate-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
                Adresse E-mail <span class="text-zinc-900 dark:text-zinc-100">*</span>
              </label>
              <div class="relative">
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="jean.dupont@entreprise.com"
                  class="w-full px-3.5 py-2.5 pl-10 rounded-xl border border-slate-300 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-zinc-900/20 dark:focus:ring-zinc-100/20 focus:border-zinc-900 dark:focus:border-zinc-400 text-sm bg-slate-50 dark:bg-zinc-900 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 transition-colors"
                />
                <AtSign class="w-4 h-4 text-slate-400 dark:text-zinc-500 absolute left-3.5 top-3" />
              </div>
            </div>
          </div>

          <!-- Ligne 2 : Objet de la prise de contact -->
          <div>
            <label for="subject" class="block text-xs font-bold font-title text-slate-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Objet de la démarche <span class="text-zinc-900 dark:text-zinc-100">*</span>
            </label>
            <div class="relative">
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-3.5 py-2.5 pl-10 pr-10 rounded-xl border border-slate-300 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-zinc-900/20 dark:focus:ring-zinc-100/20 focus:border-zinc-900 dark:focus:border-zinc-400 text-sm bg-slate-50 dark:bg-zinc-900 text-slate-900 dark:text-zinc-100 transition-colors appearance-none cursor-pointer peer"
              >
                <option value="Proposition de stage 2027 (SLAM)">🎯 Proposition de stage 2027 (SLAM)</option>
                <option value="Collaboration technique">🔨 Collaboration technique</option>
                <option value="Échange académique">🎒 Échange académique</option>
                <option value="Autre demande professionnelle">✉️ Autre demande professionnelle</option>
              </select>
              <Tag class="w-4 h-4 text-slate-400 dark:text-zinc-500 absolute left-3.5 top-3 pointer-events-none" />
              <ChevronDown class="w-4 h-4 text-slate-400 dark:text-zinc-500 absolute right-3.5 top-3 pointer-events-none transition-transform duration-200 peer-focus:rotate-180" />
            </div>
          </div>

          <!-- Ligne 3 : Message -->
          <div class="flex-1 flex flex-col min-h-[130px]">
            <label for="message" class="block text-xs font-bold font-title text-slate-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Votre message <span class="text-zinc-900 dark:text-zinc-100">*</span>
            </label>
            <div class="relative flex-1 flex flex-col">
              <textarea
                id="message"
                name="message"
                required
                placeholder="Bonjour Quentin, nous souhaitons vous proposer un entretien pour une mission de stage..."
                class="w-full flex-1 min-h-[130px] px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-zinc-900/20 dark:focus:ring-zinc-100/20 focus:border-zinc-900 dark:focus:border-zinc-400 text-sm bg-slate-50 dark:bg-zinc-900 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 transition-colors resize-y"
              ></textarea>
            </div>
          </div>

          <!-- Bouton de soumission en Noir Mat / Blanc en dark -->
          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-xl bg-zinc-900 hover:bg-black dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-semibold text-sm transition-all duration-200 shadow-sm hover:shadow transform hover:-translate-y-0.5"
          >
            <Send class="w-4 h-4" />
            <span>Envoyer le message</span>
          </button>

        </form>

      </div>
    </div>

  </div>

  <!-- Bandeau pleine largeur : Coordonnées protégées (RGPD & CNIL) -->
  <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#18181B] border border-slate-200 dark:border-[#27272A] shadow-card flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-start sm:items-center gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 flex items-center justify-center shrink-0 border border-zinc-200 dark:border-zinc-700">
        <ShieldCheck class="w-5 h-5" />
      </div>
      <div>
        <h4 class="text-xs sm:text-sm font-bold font-title text-slate-900 dark:text-zinc-100">Coordonnées protégées (RGPD & CNIL)</h4>
        <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">
          Publiées dans le cadre de l'évaluation BTS SIO et de la recherche de stage. Tout démarchage ou collecte automatisée est strictement interdit.
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2.5 shrink-0 self-end sm:self-center">
      <a
        href="/mentions-legales"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-900 dark:text-zinc-100 hover:text-black dark:hover:text-white py-2 px-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200/70 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors"
      >
        <span>Mentions légales →</span>
      </a>
      <a
        href="https://www.cnil.fr/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white py-2 px-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200/70 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors"
      >
        <span>Site officiel CNIL ↗</span>
      </a>
    </div>
  </div>

  <!-- Fenêtre Pop-up (Modale) de confirmation au centre de l'écran -->
  <div
    id="contact-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
  >
    <div
      id="contact-modal-box"
      class="bg-white dark:bg-[#18181B] border border-slate-200 dark:border-[#27272A] rounded-3xl max-w-[490px] w-full p-6 sm:p-8 shadow-2xl relative transform scale-95 transition-all duration-300 text-center"
    >
      <!-- Bouton croix pour fermer -->
      <button
        type="button"
        id="modal-close-btn"
        aria-label="Fermer la fenêtre"
        class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-zinc-200 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <X class="w-4 h-4" />
      </button>

      <!-- Icône de confirmation avec anneau de relief -->
      <div class="mx-auto w-12 h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center mb-4 ring-8 ring-zinc-50 dark:ring-zinc-900/50">
        <CheckCircle2 class="w-6 h-6 text-zinc-900 dark:text-zinc-100" />
      </div>

      <!-- Titre principal -->
      <h3 id="modal-title" class="text-xl font-bold font-title text-slate-900 dark:text-zinc-100">
        Message envoyé avec succès !
      </h3>

      <!-- Description épurée sans répétition -->
      <p class="text-sm text-slate-600 dark:text-zinc-400 mt-2">
        Merci <strong class="text-slate-900 dark:text-zinc-100" id="modal-user-name"></strong>, votre demande a bien été transmise à Quentin.
      </p>

      <!-- Fiche récapitulative élégante (Accusé de réception) -->
      <div class="mt-6 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 text-left space-y-2.5">
        <div class="flex items-center justify-between text-xs gap-3">
          <span class="text-slate-500 dark:text-zinc-400 font-medium shrink-0">Objet de la démarche</span>
          <span id="modal-subject-badge" class="font-semibold text-slate-900 dark:text-zinc-100 bg-white dark:bg-zinc-800 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-zinc-700 truncate max-w-[240px]">
            <!-- Rempli dynamiquement -->
          </span>
        </div>
        <div class="flex items-center justify-between text-xs pt-2.5 border-t border-slate-200/70 dark:border-zinc-800/80">
          <span class="text-slate-500 dark:text-zinc-400 font-medium">Engagement de réponse</span>
          <span class="inline-flex items-center gap-1.5 font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-1 rounded-lg border border-emerald-200/60 dark:border-emerald-800/40">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            Sous 48 heures maximum
          </span>
        </div>
      </div>

      <!-- Bouton d'action CTA avec libellé Compris -->
      <button
        type="button"
        id="modal-action-btn"
        class="mt-6 w-full py-3.5 px-5 rounded-xl bg-zinc-900 hover:bg-black dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-semibold text-sm transition-all duration-200 shadow-sm"
      >
        Compris
      </button>
    </div>
  </div>
</section>

<!-- Script de traitement du formulaire avec feedback propre -->
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn');
  const subjectSelect = document.getElementById('subject') as HTMLSelectElement | null;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

  // Éléments de la fenêtre pop-up
  const modal = document.getElementById('contact-modal');
  const modalBox = document.getElementById('contact-modal-box');
  const modalUserName = document.getElementById('modal-user-name');
  const modalSubjectBadge = document.getElementById('modal-subject-badge');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalActionBtn = document.getElementById('modal-action-btn');

  // Fonctions d'ouverture et fermeture de la modale
  function openModal(name: string, subject: string) {
    if (!modal || !modalBox) return;
    if (modalUserName) {
      modalUserName.textContent = name;
    }
    if (modalSubjectBadge) {
      modalSubjectBadge.textContent = subject;
    }
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalBox.classList.remove('scale-95');
    modalBox.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !modalBox) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalBox.classList.remove('scale-100');
    modalBox.classList.add('scale-95');
    document.body.style.overflow = '';
  }

  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
  if (modalActionBtn) modalActionBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
      closeModal();
    }
  });

  // Adaptation du texte indicatif selon l'objet sélectionné
  const placeholders: Record<string, string> = {
    'Proposition de stage 2027 (SLAM)': 'Bonjour Quentin, nous souhaitons vous proposer un entretien pour une mission de stage...',
    'Collaboration technique': 'Bonjour Quentin, nous souhaitons échanger avec vous au sujet d\'une collaboration technique...',
    'Échange académique': 'Bonjour Quentin, je vous contacte dans le cadre d\'un échange académique...',
    'Autre demande professionnelle': 'Bonjour Quentin, je vous contacte afin d\'échanger au sujet de...'
  };

  if (subjectSelect && messageInput) {
    subjectSelect.addEventListener('change', () => {
      const selectedVal = subjectSelect.value;
      if (placeholders[selectedVal]) {
        messageInput.placeholder = placeholders[selectedVal];
      }
      // Dès qu'une option est choisie, on retire le focus pour replacer la flèche vers le bas
      subjectSelect.blur();
    });

    subjectSelect.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        subjectSelect.blur();
      }
    });
  }

  if (form && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const subject = formData.get('subject') as string;
      const message = formData.get('message') as string;

      if (!name || !email || !message) {
        form.reportValidity();
        return;
      }

      // Simulation d'envoi et ouverture de la modale au milieu de l'écran
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-75', 'cursor-not-allowed');

      setTimeout(() => {
        form.reset();
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        openModal(name, subject);
      }, 500);
    });
  }
</script>
