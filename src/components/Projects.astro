---
// Section 6 : Projets & Réalisations (Études de Cas pour l'Épreuve E4)
import { getCollection } from 'astro:content';
import { ArrowUpRight, Github, BookOpen, Briefcase, Rocket, Layers, ExternalLink, X, FileText } from 'lucide-astro';

// Récupération de tous les projets enregistrés dans Content Collections
const allProjects = await getCollection('projects');

// Tri des projets : mis en avant d'abord, puis par date
const sortedProjects = allProjects.sort((a, b) => {
  return new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime();
});

// Extraction pédagogique de la phrase de synthèse du Markdown
function extractSummary(body: string): string {
  const match = body.match(/> \*\*Synthèse en une phrase :\*\* (.*?)(?:\n|$)/);
  if (match && match[1]) {
    return match[1].trim();
  }
  return "Étude de cas technique et mise en œuvre des compétences du Bloc 1 (Épreuve E4).";
}

// Couleurs et puces des badges de statut sobres et raffinées
function getStatusBadge(status: string) {
  switch (status.toLowerCase()) {
    case 'réalisé':
      return {
        bg: 'bg-white/95 text-slate-800 border-slate-200/90',
        label: 'Réalisé',
        dot: 'bg-emerald-500',
      };
    case 'en cours':
      return {
        bg: 'bg-white/95 text-slate-800 border-slate-200/90',
        label: 'En cours',
        dot: 'bg-amber-500',
      };
    case 'à venir':
      return {
        bg: 'bg-white/95 text-slate-700 border-slate-200/90',
        label: 'À venir',
        dot: 'bg-slate-400',
      };
    default:
      return {
        bg: 'bg-white/95 text-slate-700 border-slate-200/90',
        label: status,
        dot: 'bg-slate-400',
      };
  }
}
---

<section id="projets" class="py-16 scroll-mt-20 border-t border-slate-200">
  
  <!-- En-tête de section avec sélecteur de catégories segmenté -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
    <div>
      <h2 class="text-3xl font-bold font-title text-slate-900 tracking-tight">
        Projets & Réalisations
      </h2>
      <p class="text-sm text-slate-600 mt-2 max-w-2xl leading-relaxed">
        Études de cas concrètes et projets techniques adossés aux compétences du référentiel officiel du BTS SIO SLAM.
      </p>
    </div>

    <!-- Sélecteur d'onglets premium : Tous / Freelance / Professionnel / Scolaire -->
    <div class="inline-flex p-1.5 rounded-2xl bg-slate-100/90 border border-slate-200/80 self-start flex-wrap gap-1 shadow-inner">
      <button
        type="button"
        data-filter-btn="all"
        class="project-filter-btn active-tab inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 bg-white text-slate-900 shadow-sm"
      >
        <span>Tous</span>
        <span class="count-badge px-2 py-0.5 rounded-full text-[10px] font-bold bg-zinc-900 text-white">
          {allProjects.length}
        </span>
      </button>
      <button
        type="button"
        data-filter-btn="freelance"
        class="project-filter-btn inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all duration-200"
      >
        <span>Freelance</span>
        <span class="count-badge px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200/80 text-slate-600">
          {allProjects.filter(p => p.data.category === 'freelance').length}
        </span>
      </button>
      <button
        type="button"
        data-filter-btn="professionnel"
        class="project-filter-btn inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all duration-200"
      >
        <span>Professionnel</span>
        <span class="count-badge px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200/80 text-slate-600">
          {allProjects.filter(p => p.data.category === 'professionnel').length}
        </span>
      </button>
      <button
        type="button"
        data-filter-btn="scolaire"
        class="project-filter-btn inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all duration-200"
      >
        <span>Scolaire</span>
        <span class="count-badge px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200/80 text-slate-600">
          {allProjects.filter(p => p.data.category === 'scolaire').length}
        </span>
      </button>
    </div>
  </div>

  <!-- Grille de cartes équilibrée en 2 colonnes (Format 2x2 harmonieux) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-7" id="projects-grid">
    {sortedProjects.map((project) => {
      const statusBadge = getStatusBadge(project.data.status);
      const summary = extractSummary(project.body);

      return (
        <article
          class="project-card bg-white rounded-2xl border border-slate-200/90 shadow-card hover:shadow-card-hover hover:border-slate-300 transition-all duration-300 flex flex-col justify-between overflow-hidden group"
          data-category={project.data.category}
        >
          <!-- Bloc Supérieur : Visuel et Badges -->
          <div>
            <!-- Miniature 16:9 avec photo / capture soignée -->
            <div class="relative aspect-video w-full overflow-hidden bg-slate-950 border-b border-slate-100">
              <img
                src={project.data.thumbnail}
                alt={project.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="hidden w-full h-full bg-slate-900 text-slate-200 flex-col items-center justify-center p-4 text-center">
                <Layers class="w-8 h-8 text-zinc-400 mb-2" />
                <span class="text-xs font-semibold font-title">{project.data.title}</span>
              </div>

              <!-- Voile sombre discret supérieur et inférieur pour une parfaite lisibilité des badges -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-slate-950/40 pointer-events-none"></div>

              <!-- Badge de statut flottant (gauche) : capsule épurée avec point de couleur -->
              <div class="absolute top-3.5 left-3.5">
                <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold border backdrop-blur-md shadow-xs ${statusBadge.bg}`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${statusBadge.dot}`}></span>
                  <span>{statusBadge.label}</span>
                </span>
              </div>

              <!-- Badge de catégorie flottant (droite) : Freelance / Professionnel / Scolaire -->
              <div class="absolute top-3.5 right-3.5">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-slate-950/80 text-white backdrop-blur-md border border-white/15 shadow-xs font-sans">
                  {project.data.category === 'freelance' ? (
                    <>
                      <Rocket class="w-3.5 h-3.5 text-amber-400" />
                      <span>Freelance</span>
                    </>
                  ) : project.data.category === 'professionnel' ? (
                    <>
                      <Briefcase class="w-3.5 h-3.5 text-zinc-400" />
                      <span>Professionnel</span>
                    </>
                  ) : (
                    <>
                      <BookOpen class="w-3.5 h-3.5 text-zinc-400" />
                      <span>Scolaire</span>
                    </>
                  )}
                </span>
              </div>
            </div>

            <!-- Contenu textuel de la carte -->
            <div class="p-6 space-y-3">
              <!-- Titre du projet -->
              <h3 class="text-lg font-bold font-title text-slate-900 group-hover:text-zinc-950 transition-colors leading-snug tracking-tight">
                <a
                  href={`/projets/${project.slug}`}
                  class="project-modal-trigger cursor-pointer"
                  data-project-title={project.data.title}
                >
                  {project.data.title}
                </a>
              </h3>

              <!-- Synthèse métier concise -->
              <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
                {summary}
              </p>

              <!-- Pastilles technologiques feutrées et modernes -->
              <div class="flex flex-wrap gap-1.5 pt-2">
                {project.data.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-lg bg-slate-50 text-slate-600 text-xs font-medium border border-slate-200/80 group-hover:border-slate-300 transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Pied de carte épuré : action principale et liens secondaires -->
          <div class="px-6 py-4 bg-slate-50/60 border-t border-slate-100 flex items-center justify-between gap-3 mt-auto">
            <!-- Bouton principal : Consulter l'étude de cas (Ouvre la modale d'information) -->
            <a
              href={`/projets/${project.slug}`}
              class="project-modal-trigger inline-flex items-center gap-1.5 text-xs font-bold text-zinc-900 hover:text-black transition-colors group/link py-1 cursor-pointer"
              data-project-title={project.data.title}
            >
              <span>Consulter l'étude de cas</span>
              <ArrowUpRight class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform" />
            </a>

            <!-- Liens annexes (Code source / Démo) -->
            <div class="flex items-center gap-1">
              {project.data.repoUrl && (
                <a
                  href={project.data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="repo-modal-trigger inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-white hover:border-slate-200 border border-transparent hover:shadow-xs transition-all cursor-pointer"
                  data-project-title={project.data.title}
                  title="Code source sur GitHub"
                >
                  <Github class="w-3.5 h-3.5" />
                  <span class="hidden sm:inline">Code source</span>
                </a>
              )}
              {project.data.demoUrl && (
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-white hover:border-slate-200 border border-transparent hover:shadow-xs transition-all"
                  title="Voir la démo en ligne"
                >
                  <ExternalLink class="w-3.5 h-3.5" />
                  <span class="hidden sm:inline">Démo</span>
                </a>
              )}
            </div>
          </div>

        </article>
      );
    })}
  </div>

  <!-- Fenêtre modale d'information : Étude de cas en cours de rédaction -->
  <div
    id="project-wip-modal-backdrop"
    class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4"
    aria-hidden="true"
  >
    <div
      id="project-wip-modal-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="project-wip-modal-title"
      class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-slate-200 transform scale-95 transition-all duration-200 relative flex flex-col items-center text-center"
    >
      <!-- Bouton de fermeture instantanée avec croix -->
      <button
        id="project-wip-modal-close"
        type="button"
        aria-label="Fermer la fenêtre d'information"
        class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-900 cursor-pointer"
      >
        <X class="w-5 h-5" />
      </button>

      <!-- Icône thématique centrale sobre et professionnelle (Fiche documentaire) -->
      <div class="w-20 h-20 rounded-2xl bg-zinc-100 border border-zinc-200 flex items-center justify-center mb-5 text-zinc-900 shadow-inner">
        <FileText class="w-9 h-9 text-zinc-900" />
      </div>

      <!-- Titre principal de la modale -->
      <h3 id="project-wip-modal-title" class="text-2xl font-black font-title text-slate-900 tracking-tight mb-2">
        Étude de cas bientôt disponible
      </h3>

      <!-- Nom du projet sélectionné -->
      <div class="mb-4 px-3.5 py-1.5 rounded-xl bg-slate-100/90 text-slate-800 text-xs font-semibold max-w-full border border-slate-200/80">
        <span id="project-wip-modal-name"></span>
      </div>

      <!-- Explication pédagogique et professionnelle -->
      <p class="text-sm text-slate-600 leading-relaxed font-normal mb-6">
        La fiche descriptive complète ainsi que l'analyse technique détaillée de cette réalisation sont actuellement en cours d'écriture et de consolidation.
        <br class="hidden sm:inline" />
        Cette documentation sera accessible très prochainement.
      </p>

      <!-- Bouton de confirmation pour fermer la fenêtre -->
      <button
        id="project-wip-modal-btn"
        type="button"
        class="w-full py-3 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-zinc-900 cursor-pointer"
      >
        Compris
      </button>
    </div>
  </div>

  <!-- Fenêtre modale d'information : Code source / Dépôt GitHub -->
  <div
    id="repo-wip-modal-backdrop"
    class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4"
    aria-hidden="true"
  >
    <div
      id="repo-wip-modal-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="repo-wip-modal-title"
      class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-slate-200 transform scale-95 transition-all duration-200 relative flex flex-col items-center text-center"
    >
      <!-- Bouton de fermeture instantanée avec croix -->
      <button
        id="repo-wip-modal-close"
        type="button"
        aria-label="Fermer la fenêtre d'information"
        class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-600 cursor-pointer"
      >
        <X class="w-5 h-5" />
      </button>

      <!-- Icône officielle GitHub dans un écrin sobre et moderne -->
      <div class="w-20 h-20 rounded-2xl bg-slate-100 border border-slate-200/80 flex items-center justify-center mb-5 text-slate-800 shadow-inner">
        <Github class="w-9 h-9 text-slate-900" />
      </div>

      <!-- Titre principal de la modale -->
      <h3 id="repo-wip-modal-title" class="text-2xl font-black font-title text-slate-900 tracking-tight mb-2">
        Code source bientôt accessible
      </h3>

      <!-- Nom du projet sélectionné -->
      <div class="mb-4 px-3.5 py-1.5 rounded-xl bg-slate-100/90 text-slate-800 text-xs font-semibold max-w-full border border-slate-200/80">
        <span id="repo-wip-modal-name"></span>
      </div>

      <!-- Explication professionnelle et soignée -->
      <p class="text-sm text-slate-600 leading-relaxed font-normal mb-6">
        Le dépôt GitHub associé à cette réalisation est actuellement en cours de préparation, de nettoyage ou maintenu en accès privé pour des raisons de confidentialité.
        <br class="hidden sm:inline" />
        Le code sera consultable publiquement dès son officialisation.
      </p>

      <!-- Bouton de confirmation pour fermer la fenêtre -->
      <button
        id="repo-wip-modal-btn"
        type="button"
        class="w-full py-3 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-600 cursor-pointer"
      >
        Compris
      </button>
    </div>
  </div>
</section>

<!-- Script interactif de filtrage des projets et gestion de la modale -->
<script>
  function setupProjectFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.project-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');

    function applyFilter(category: string) {
      // Mise à jour de l'état visuel des boutons et de leurs puces de comptage
      buttons.forEach((btn) => {
        const btnFilter = btn.getAttribute('data-filter-btn');
        const countBadge = btn.querySelector('.count-badge');
        
        if (btnFilter === category) {
          btn.classList.add('bg-white', 'text-slate-900', 'shadow-sm', 'font-semibold');
          btn.classList.remove('text-slate-600', 'font-medium', 'hover:bg-slate-200/50');
          if (countBadge) {
            countBadge.classList.add('bg-zinc-900', 'text-white', 'font-bold');
            countBadge.classList.remove('bg-slate-200/80', 'text-slate-600', 'font-semibold');
          }
        } else {
          btn.classList.remove('bg-white', 'text-slate-900', 'shadow-sm', 'font-semibold');
          btn.classList.add('text-slate-600', 'font-medium', 'hover:bg-slate-200/50');
          if (countBadge) {
            countBadge.classList.remove('bg-zinc-900', 'text-white', 'font-bold');
            countBadge.classList.add('bg-slate-200/80', 'text-slate-600', 'font-semibold');
          }
        }
      });

      // Filtrage dynamique des cartes avec affichage flexible
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (category === 'all' || cardCat === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter-btn') || 'all';
        applyFilter(filter);
      });
    });

    // Écoute de l'événement global déclenché depuis la Sidebar
    window.addEventListener('filter-projects', (e: any) => {
      if (e.detail && e.detail.category) {
        applyFilter(e.detail.category);
      }
    });
  }

  // Gestion de la modale d'information pour les études de cas en cours d'écriture
  function setupProjectModals() {
    const wipModalBackdrop = document.getElementById('project-wip-modal-backdrop');
    const wipModalCard = document.getElementById('project-wip-modal-card');
    const wipModalClose = document.getElementById('project-wip-modal-close');
    const wipModalBtn = document.getElementById('project-wip-modal-btn');
    const wipModalName = document.getElementById('project-wip-modal-name');
    const projectTriggers = document.querySelectorAll('.project-modal-trigger');

    function openWipModal(projectName: string) {
      if (!wipModalBackdrop || !wipModalCard || !wipModalName) return;

      wipModalName.textContent = projectName;
      wipModalBackdrop.classList.remove('hidden');
      setTimeout(() => {
        wipModalBackdrop.classList.add('opacity-100');
        wipModalCard.classList.remove('scale-95');
        wipModalCard.classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeWipModal() {
      if (!wipModalBackdrop || !wipModalCard) return;
      wipModalBackdrop.classList.remove('opacity-100');
      wipModalCard.classList.remove('scale-100');
      wipModalCard.classList.add('scale-95');
      setTimeout(() => {
        wipModalBackdrop.classList.add('hidden');
      }, 200);
      document.body.style.overflow = '';
    }

    projectTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const title = trigger.getAttribute('data-project-title') || 'Projet sélectionné';
        openWipModal(title);
      });
    });

    if (wipModalClose) {
      wipModalClose.addEventListener('click', closeWipModal);
    }

    if (wipModalBtn) {
      wipModalBtn.addEventListener('click', closeWipModal);
    }

    if (wipModalBackdrop) {
      wipModalBackdrop.addEventListener('click', (e) => {
        if (e.target === wipModalBackdrop) {
          closeWipModal();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && wipModalBackdrop && !wipModalBackdrop.classList.contains('hidden')) {
        closeWipModal();
      }
    });
  }

  // Gestion de la modale pour le code source GitHub
  function setupRepoModals() {
    const repoModalBackdrop = document.getElementById('repo-wip-modal-backdrop');
    const repoModalCard = document.getElementById('repo-wip-modal-card');
    const repoModalClose = document.getElementById('repo-wip-modal-close');
    const repoModalBtn = document.getElementById('repo-wip-modal-btn');
    const repoModalName = document.getElementById('repo-wip-modal-name');
    const repoTriggers = document.querySelectorAll('.repo-modal-trigger');

    function openRepoModal(projectName: string) {
      if (!repoModalBackdrop || !repoModalCard || !repoModalName) return;

      repoModalName.textContent = projectName;
      repoModalBackdrop.classList.remove('hidden');
      setTimeout(() => {
        repoModalBackdrop.classList.add('opacity-100');
        repoModalCard.classList.remove('scale-95');
        repoModalCard.classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeRepoModal() {
      if (!repoModalBackdrop || !repoModalCard) return;
      repoModalBackdrop.classList.remove('opacity-100');
      repoModalCard.classList.remove('scale-100');
      repoModalCard.classList.add('scale-95');
      setTimeout(() => {
        repoModalBackdrop.classList.add('hidden');
      }, 200);
      document.body.style.overflow = '';
    }

    repoTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const title = trigger.getAttribute('data-project-title') || 'Projet sélectionné';
        openRepoModal(title);
      });
    });

    if (repoModalClose) {
      repoModalClose.addEventListener('click', closeRepoModal);
    }

    if (repoModalBtn) {
      repoModalBtn.addEventListener('click', closeRepoModal);
    }

    if (repoModalBackdrop) {
      repoModalBackdrop.addEventListener('click', (e) => {
        if (e.target === repoModalBackdrop) {
          closeRepoModal();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && repoModalBackdrop && !repoModalBackdrop.classList.contains('hidden')) {
        closeRepoModal();
      }
    });
  }

  // Initialisation lors du chargement de la page
  setupProjectFilters();
  setupProjectModals();
  setupRepoModals();
</script>
