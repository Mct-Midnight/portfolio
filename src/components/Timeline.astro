---
// Section 3 : Parcours (Timeline de Formation & Cursus)
import { MapPin, Calendar } from 'lucide-astro';
import timelineData from '../content/data/timeline.json';

const { education } = timelineData;
---

<section id="parcours" class="py-16 scroll-mt-20 border-t border-slate-200 dark:border-zinc-800">
  <!-- En-tête de section -->
  <div class="mb-12">
    <h2 class="text-3xl font-bold font-title text-slate-900 dark:text-zinc-100 tracking-tight">
      Parcours de Formation
    </h2>
    <p class="text-sm text-slate-600 dark:text-zinc-400 mt-2 max-w-2xl">
      Historique académique post-bac et modules d'ingénierie préparant à l'exercice du métier de développeur d'applications.
    </p>
  </div>

  <!-- Timeline continue verticale monochrome mat -->
  <div class="relative pl-6 sm:pl-8 border-l-2 border-zinc-200 dark:border-zinc-800 space-y-7 ml-3 sm:ml-4">
    {education.map((item) => (
      <div class="relative group">
        
        <!-- Puce continue Noir Mat / Titane Clair -->
        <div class="absolute -left-[31px] sm:-left-[39px] top-2 w-5 h-5 rounded-full bg-white dark:bg-[#18181B] border-4 border-zinc-900 dark:border-zinc-100 group-hover:scale-125 transition-transform duration-200 shadow-sm flex items-center justify-center">
          <div class={`w-1.5 h-1.5 rounded-full ${item.status === 'en_cours' ? 'bg-zinc-900 dark:bg-zinc-100 animate-pulse' : 'bg-zinc-900 dark:bg-zinc-100'}`}></div>
        </div>

        <!-- Carte d'étape blanche épurée / anthracite en sombre -->
        <div class={`bg-white dark:bg-[#18181B] p-5 sm:p-6 rounded-2xl shadow-card border ${item.status === 'en_cours' ? 'border-zinc-300 dark:border-zinc-700 ring-1 ring-zinc-900/10 dark:ring-zinc-100/10' : 'border-zinc-200 dark:border-[#27272A]'} hover:shadow-card-hover hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-200`}>
          
          <!-- En-tête de l'étape : Diplôme, Établissement et Date -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
            <div>
              <h3 class="text-lg sm:text-xl font-bold font-title text-zinc-900 dark:text-zinc-100">
                {item.degree}
              </h3>
              <p class="text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400 flex items-center gap-2 mt-1 flex-wrap">
                <span class="text-zinc-900 dark:text-zinc-200 font-semibold">{item.institution}</span>
                <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600 shrink-0 select-none" aria-hidden="true"></span>
                <span class="inline-flex items-center gap-1 text-zinc-500 dark:text-zinc-400">
                  <MapPin class="w-3.5 h-3.5 text-zinc-400" />
                  {item.location}
                </span>
              </p>
            </div>

            <!-- Badge temporel discret monochrome -->
            <div class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold shrink-0 self-start sm:self-center ${item.status === 'en_cours' ? 'bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 border border-zinc-800 dark:border-zinc-200' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700'}`}>
              <Calendar class={`w-3.5 h-3.5 ${item.status === 'en_cours' ? 'text-zinc-300 dark:text-zinc-700' : 'text-zinc-500 dark:text-zinc-400'}`} />
              <span>{item.period}</span>
            </div>
          </div>

          <!-- Description concise et valorisante -->
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-3">
            {item.description}
          </p>

        </div>

      </div>
    ))}
  </div>
</section>
