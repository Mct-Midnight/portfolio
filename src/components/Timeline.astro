---
// Section 3 : Parcours (Timeline de Formation & Cursus)
import { MapPin, Calendar } from 'lucide-astro';
import timelineData from '../content/data/timeline.json';

const { education } = timelineData;
---

<section id="parcours" class="py-16 scroll-mt-20 border-t border-slate-200">
  <!-- En-tête de section -->
  <div class="mb-12">
    <h2 class="text-3xl font-bold font-title text-slate-900 tracking-tight">
      Parcours de Formation
    </h2>
    <p class="text-sm text-slate-600 mt-2 max-w-2xl">
      Historique académique post-bac et modules d'ingénierie préparant à l'exercice du métier de développeur d'applications.
    </p>
  </div>

  <!-- Timeline continue verticale en Bleu Cobalt -->
  <div class="relative pl-6 sm:pl-8 border-l-2 border-blue-600/30 space-y-7 ml-3 sm:ml-4">
    {education.map((item) => (
      <div class="relative group">
        
        <!-- Puce continue Bleu Cobalt -->
        <div class="absolute -left-[31px] sm:-left-[39px] top-2 w-5 h-5 rounded-full bg-white border-4 border-blue-600 group-hover:scale-125 transition-transform duration-200 shadow-sm flex items-center justify-center">
          <div class={`w-1.5 h-1.5 rounded-full ${item.status === 'en_cours' ? 'bg-blue-600 animate-pulse' : 'bg-blue-600'}`}></div>
        </div>

        <!-- Carte d'étape blanche épurée -->
        <div class={`bg-white p-5 sm:p-6 rounded-2xl shadow-card border ${item.status === 'en_cours' ? 'border-blue-300 ring-1 ring-blue-600/10' : 'border-slate-200'} hover:shadow-card-hover hover:border-blue-400 transition-all duration-200`}>
          
          <!-- En-tête de l'étape : Diplôme, Établissement et Date -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
            <div>
              <h3 class="text-lg sm:text-xl font-bold font-title text-slate-900">
                {item.degree}
              </h3>
              <p class="text-xs sm:text-sm font-medium text-slate-500 flex items-center gap-2 mt-1 flex-wrap">
                <span class="text-blue-600 font-semibold">{item.institution}</span>
                <span class="text-slate-300">·</span>
                <span class="inline-flex items-center gap-1 text-slate-500">
                  <MapPin class="w-3.5 h-3.5 text-slate-400" />
                  {item.location}
                </span>
              </p>
            </div>

            <!-- Badge temporel discret -->
            <div class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold shrink-0 self-start sm:self-center ${item.status === 'en_cours' ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-slate-50 text-slate-600 border border-slate-200'}`}>
              <Calendar class="w-3.5 h-3.5 text-blue-600" />
              <span>{item.period}</span>
            </div>
          </div>

          <!-- Description concise et valorisante -->
          <p class="text-sm text-slate-600 leading-relaxed mt-3">
            {item.description}
          </p>

        </div>

      </div>
    ))}
  </div>
</section>
