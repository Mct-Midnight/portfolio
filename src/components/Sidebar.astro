---
// Composant Sidebar pour le Layout Dual-Pane (Desktop fixe 260px + Tiroir Mobile réactif)
import {
  Home,
  User,
  GraduationCap,
  Wrench,
  Award,
  FolderGit2,
  Mail,
  FileText,
  Menu,
  X,
  BookOpen,
  Briefcase,
  Rocket,
  ExternalLink,
} from 'lucide-astro';
import profileData from '../content/data/profile.json';

const { identity } = profileData;
const initials = `${identity.firstName[0] || 'Q'}${identity.lastName[0] || 'M'}`;

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isHome = currentPath === '/';
const basePath = isHome ? '' : '/';
---

<!-- Barre supérieure mobile (Visible uniquement sur écran < 1024px) -->
<header
  class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-[#0F172A] border-b border-[#1E293B] z-50 flex items-center justify-between px-4"
>
  <a href={`${basePath}#hero`} class="flex items-center gap-3 group">
    <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-blue-600 bg-slate-800 flex items-center justify-center">
      <img
        src={identity.avatarUrl}
        alt={`${identity.firstName} ${identity.lastName}`}
        class="w-full h-full object-cover"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <span class="hidden font-bold text-white text-xs">{initials}</span>
    </div>
    <div>
      <span class="text-white font-bold text-sm block font-title">{identity.firstName} {identity.lastName}</span>
      <span class="text-xs text-blue-400 block">{identity.subRole}</span>
    </div>
  </a>

  <!-- Bouton déclencheur du Drawer Mobile -->
  <button
    id="mobile-menu-open-btn"
    aria-label="Ouvrir le menu de navigation"
    class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-600"
  >
    <Menu class="w-6 h-6" />
  </button>
</header>

<!-- Volet d'arrière-plan semi-transparent (Backdrop Mobile) -->
<div
  id="drawer-backdrop"
  class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 hidden transition-opacity duration-300 opacity-0 lg:hidden"
  aria-hidden="true"
></div>

<!-- Volet latéral fixe (Sidebar Desktop & Drawer Mobile) -->
<aside
  id="sidebar-pane"
  class="fixed top-0 bottom-0 left-0 w-[260px] bg-[#090D16] text-slate-200 border-r border-[#1E293B] z-50 flex flex-col justify-between transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0"
>
  <!-- Partie Supérieure : En-tête Profil -->
  <div class="p-6 border-b border-[#1E293B]">
    <div class="flex items-center justify-between lg:hidden mb-4">
      <span class="text-xs uppercase tracking-widest text-blue-400 font-bold font-title">Navigation</span>
      <button
        id="mobile-menu-close-btn"
        aria-label="Fermer le menu de navigation"
        class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- Avatar et Identité -->
    <div class="text-center">
      <div class="relative inline-block mx-auto mb-3">
        <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-blue-500/80 shadow-lg bg-slate-800 flex items-center justify-center p-0.5">
          <img
            src={identity.avatarUrl}
            alt={`${identity.firstName} ${identity.lastName}`}
            class="w-full h-full object-cover rounded-full"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <span class="hidden font-bold text-white text-2xl font-title">{initials}</span>
        </div>
        <!-- Indicateur de recherche de stage actif -->
        <span
          class="absolute bottom-1 right-1 w-4 h-4 bg-emerald-500 border-2 border-[#090D16] rounded-full ring-2 ring-emerald-500/30 animate-pulse"
          title="En recherche de stage SLAM (Mai-Août 2027)"
        ></span>
      </div>

      <h1 class="text-white font-extrabold text-lg tracking-tight font-title">{identity.firstName} {identity.lastName}</h1>
      <p class="text-xs text-blue-400 font-semibold mt-0.5">{identity.subRole}</p>
      <p class="text-[11px] text-slate-400 mt-1">{identity.institution}</p>
    </div>
  </div>

  <!-- Navigation Principale repositionnée vers le haut avec dimensions confortables -->
  <nav class="flex-1 px-3.5 py-5 space-y-2 lg:space-y-2.5 overflow-y-auto" id="sidebar-nav">
    <a
      href={`${basePath}#hero`}
      class="nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200 group"
      data-section="hero"
    >
      <Home class="w-5 h-5 text-blue-400 group-hover:text-blue-300 shrink-0 transition-colors" />
      <span>Accueil</span>
    </a>

    <a
      href={`${basePath}#profil`}
      class="nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200 group"
      data-section="profil"
    >
      <User class="w-5 h-5 text-blue-400 group-hover:text-blue-300 shrink-0 transition-colors" />
      <span>Profil & Stage 2027</span>
    </a>

    <a
      href={`${basePath}#parcours`}
      class="nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200 group"
      data-section="parcours"
    >
      <GraduationCap class="w-5 h-5 text-blue-400 group-hover:text-blue-300 shrink-0 transition-colors" />
      <span>Parcours & Cursus</span>
    </a>

    <a
      href={`${basePath}#competences`}
      class="nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200 group"
      data-section="competences"
    >
      <Wrench class="w-5 h-5 text-blue-400 group-hover:text-blue-300 shrink-0 transition-colors" />
      <span>Compétences Tech</span>
    </a>

    <a
      href={`${basePath}#certifications`}
      class="nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200 group"
      data-section="certifications"
    >
      <Award class="w-5 h-5 text-blue-400 group-hover:text-blue-300 shrink-0 transition-colors" />
      <span>Certifications</span>
    </a>

    <!-- Rubrique Projets avec sous-onglets indentés -->
    <div class="pt-1">
      <a
        href={`${basePath}#projets`}
        class="nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200 group"
        data-section="projets"
      >
        <FolderGit2 class="w-5 h-5 text-blue-400 group-hover:text-blue-300 shrink-0 transition-colors" />
        <span>Projets (Épreuve E4)</span>
      </a>

      <!-- Sous-liens indentés pour Projets Freelance, Professionnels et Scolaires -->
      <div class="ml-7 pl-3 border-l border-slate-800 mt-2 space-y-1.5">
        <a
          href={`${basePath}#projets`}
          data-filter="freelance"
          class="project-subnav-link flex items-center gap-2 py-2 px-2.5 rounded-lg text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-800/50 transition-colors"
        >
          <Rocket class="w-3.5 h-3.5 text-amber-400" />
          <span>Freelance</span>
        </a>
        <a
          href={`${basePath}#projets`}
          data-filter="professionnel"
          class="project-subnav-link flex items-center gap-2 py-2 px-2.5 rounded-lg text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-800/50 transition-colors"
        >
          <Briefcase class="w-3.5 h-3.5 text-blue-400" />
          <span>Professionnel</span>
        </a>
        <a
          href={`${basePath}#projets`}
          data-filter="scolaire"
          class="project-subnav-link flex items-center gap-2 py-2 px-2.5 rounded-lg text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-800/50 transition-colors"
        >
          <BookOpen class="w-3.5 h-3.5 text-sky-400" />
          <span>Scolaire</span>
        </a>
      </div>
    </div>

    <a
      href={`${basePath}#contact`}
      class="nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-200 group"
      data-section="contact"
    >
      <Mail class="w-5 h-5 text-blue-400 group-hover:text-blue-300 shrink-0 transition-colors" />
      <span>Contact</span>
    </a>
  </nav>

  <!-- Partie Inférieure : Téléchargement CV et Footer Sidebar -->
  <div class="p-4 border-t border-[#1E293B] space-y-3">
    <!-- Bouton rapide CV -->
    <a
      href={identity.cvDownloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center justify-center gap-2 w-full py-2.5 px-3 rounded-xl bg-slate-800/90 hover:bg-blue-600 text-white text-xs font-semibold tracking-wide border border-slate-700 hover:border-blue-600 transition-all duration-200 shadow-sm"
    >
      <FileText class="w-4 h-4 text-blue-400 group-hover:text-white transition-colors" />
      <span>Consulter mon CV (PDF)</span>
      <ExternalLink class="w-3 h-3 opacity-60 group-hover:opacity-100" />
    </a>

    <!-- Mentions légales & Année académique -->
    <div class="text-[11px] text-slate-400 text-center leading-relaxed">
      <span>BTS SIO SLAM · Session 2026-2028</span>
    </div>
  </div>
</aside>

<!-- Script interactif du Drawer Mobile et des filtres de projets -->
<script>
  // Gestion de l'ouverture et fermeture du tiroir mobile
  const openBtn = document.getElementById('mobile-menu-open-btn');
  const closeBtn = document.getElementById('mobile-menu-close-btn');
  const backdrop = document.getElementById('drawer-backdrop');
  const sidebar = document.getElementById('sidebar-pane');
  const navLinks = document.querySelectorAll('.nav-link, .project-subnav-link');

  function openDrawer() {
    if (!sidebar || !backdrop) return;
    sidebar.classList.remove('-translate-x-full');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      backdrop.classList.add('opacity-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!sidebar || !backdrop) return;
    sidebar.classList.add('-translate-x-full');
    backdrop.classList.remove('opacity-100');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 300);
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);

  // Fermeture automatique lors d'un clic sur un lien d'ancrage sur mobile
  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 1024) {
        closeDrawer();
      }
    });
  });

  // Gestion des sous-liens de projets avec déclenchement de l'onglet correspondant
  const subLinks = document.querySelectorAll('.project-subnav-link');
  subLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const filter = link.getAttribute('data-filter');
      if (filter) {
        // Envoi d'un événement personnalisé vers le composant Projets
        window.dispatchEvent(new CustomEvent('filter-projects', { detail: { category: filter } }));
      }
    });
  });

  // Détection et mise en surbrillance automatique de l'onglet actif (Bleu Cobalt)
  const sections = document.querySelectorAll('section[id]');
  const mainNavLinks = document.querySelectorAll('.nav-link');

  function highlightActiveNav() {
    const scrollY = window.scrollY + 120;
    sections.forEach((section) => {
      const sectionHeight = (section as HTMLElement).offsetHeight;
      const sectionTop = (section as HTMLElement).offsetTop;
      const sectionId = section.getAttribute('id');

      if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
        mainNavLinks.forEach((link) => {
          if (link.getAttribute('data-section') === sectionId) {
            link.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
            link.classList.remove('text-slate-300', 'hover:bg-slate-800/70');
            const icon = link.querySelector('svg');
            if (icon) {
              icon.classList.remove('text-blue-400');
              icon.classList.add('text-white');
            }
          } else {
            link.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
            link.classList.add('text-slate-300', 'hover:bg-slate-800/70');
            const icon = link.querySelector('svg');
            if (icon) {
              icon.classList.add('text-blue-400');
              icon.classList.remove('text-white');
            }
          }
        });
      }
    });
  }

  window.addEventListener('scroll', highlightActiveNav, { passive: true });
  highlightActiveNav();
</script>
